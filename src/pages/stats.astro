---
import { loadExchanges, COUNTRY_NAMES, SERVICE_NAMES, countryFlag, footerStats } from '../lib/data.js';
import '../styles/global.css';

const exchanges = loadExchanges();
const stats = footerStats(exchanges);
const total = exchanges.length;

const jurisdictionCount = (ex) => Object.keys(ex.countries ?? {}).length;

const withGenuineLicence = exchanges.filter((ex) => {
  if (ex.eu_status === 'authorised') return true;
  return Object.values(ex.countries ?? {}).some((entry) =>
    (Array.isArray(entry) ? entry : [entry]).some((e) => e.status === 'licensed'));
}).length;
const amlOnly = total - withGenuineLicence;

const multiJurisdiction = exchanges.filter((ex) => jurisdictionCount(ex) > 1).length;
const withdrawn = exchanges.filter((ex) => ex.eu_status === 'withdrawn').length;

const maxJurisdictions = Math.max(...exchanges.map(jurisdictionCount));
const topByJurisdictions = [...exchanges]
  .sort((a, b) => jurisdictionCount(b) - jurisdictionCount(a))
  .slice(0, 20);

// Home-state distribution across EEA entities -- which national regulator
// actually issues the most MiCA authorisations in our tracked set.
const homeStateCounts = {};
for (const ex of exchanges) {
  for (const ent of ex.entities ?? []) {
    if (ent.home_state) homeStateCounts[ent.home_state] = (homeStateCounts[ent.home_state] ?? 0) + 1;
  }
}
const allHomeStates = Object.entries(homeStateCounts).sort((a, b) => b[1] - a[1]);

// EU status breakdown -- authorised/withdrawn/no_eu_entity across every
// tracked brand, regardless of non-EEA presence.
const euStatusCounts = {
  authorised: exchanges.filter((ex) => ex.eu_status === 'authorised').length,
  withdrawn: exchanges.filter((ex) => ex.eu_status === 'withdrawn').length,
  no_eu_entity: exchanges.filter((ex) => ex.eu_status === 'no_eu_entity').length,
};

// How many brands hold each specific genuine crypto-licence, not just
// "genuine licence somewhere" -- a brand can appear in more than one row.
// NY DFS shares the "US" countries key with federal FinCEN, and ADGM
// shares "AE" with Dubai VARA (two independent regimes under one country
// page each, see [country].astro) so both need the same via-field special
// case used on the Regulators page, not a plain countries.<CC> lookup
// (which would silently merge them, since both pairs share the same
// status: 'licensed' value) like the others.
const genuineByRegime = [
  { label: 'EU MiCA', cc: null, count: exchanges.filter((ex) => ex.eu_status === 'authorised').length },
  { label: 'Dubai VARA', cc: 'AE', count: exchanges.filter((ex) => (ex.countries?.AE ?? []).some((e) => e.via === 'dubai_vara')).length },
  { label: 'Abu Dhabi ADGM', cc: 'AE', count: exchanges.filter((ex) => (ex.countries?.AE ?? []).some((e) => e.via === 'adgm_manual')).length },
  { label: 'Singapore MAS', cc: 'SG', count: exchanges.filter((ex) => (ex.countries?.SG ?? []).some((e) => e.status === 'licensed')).length },
  { label: 'Hong Kong SFC', cc: 'HK', count: exchanges.filter((ex) => (ex.countries?.HK ?? []).some((e) => e.status === 'licensed')).length },
  { label: 'Gibraltar GFSC', cc: 'GI', count: exchanges.filter((ex) => (ex.countries?.GI ?? []).some((e) => e.status === 'licensed')).length },
  { label: 'Japan FSA', cc: 'JP', count: exchanges.filter((ex) => (ex.countries?.JP ?? []).some((e) => e.status === 'licensed')).length },
  { label: 'Malaysia SC', cc: 'MY', count: exchanges.filter((ex) => (ex.countries?.MY ?? []).some((e) => e.status === 'licensed')).length },
  { label: 'New York DFS', cc: 'US', count: exchanges.filter((ex) => (ex.countries?.US ?? []).some((e) => e.via === 'ny_dfs_register')).length },
].sort((a, b) => b.count - a.count);

// Which MiCA-authorised services are actually most common -- counted
// across active (non-withdrawn) EEA records only.
const servicesCounts = {};
for (const ex of exchanges) {
  for (const ent of ex.entities ?? []) {
    for (const rec of ent.records ?? []) {
      if (rec.status !== 'authorised') continue;
      for (const svc of rec.services ?? []) servicesCounts[svc] = (servicesCounts[svc] ?? 0) + 1;
    }
  }
}
const servicesSorted = Object.entries(servicesCounts).sort((a, b) => b[1] - a[1]);

// Per-jurisdiction breakdown (non-EEA sources), reusing the same
// list-shaped countries.<CC> data the country pages render from.
const nonEEA = [
  { cc: 'GB', label: 'UK (FCA Register)' },
  { cc: 'CA', label: 'Canada (FINTRAC)' },
  { cc: 'SG', label: 'Singapore (MAS)' },
  { cc: 'US', label: 'US (FinCEN)' },
  { cc: 'HK', label: 'Hong Kong (SFC)' },
  { cc: 'GI', label: 'Gibraltar (GFSC, manual)' },
  { cc: 'JP', label: 'Japan (FSA)' },
  { cc: 'MY', label: 'Malaysia (SC)' },
  { cc: 'KR', label: 'South Korea (FIU)' },
  { cc: 'NZ', label: 'New Zealand (FSPR, manual)' },
].map(({ cc, label }) => ({
  cc, label,
  count: exchanges.filter((ex) => ex.countries?.[cc]).length,
}));
// NY DFS is a second, independent source under the same US country page,
// and ADGM the same under AE -- see the genuineByRegime comment above.
const nyDfsCount = exchanges.filter((ex) => (ex.countries?.US ?? []).some((e) => e.via === 'ny_dfs_register')).length;
const varaCount = exchanges.filter((ex) => (ex.countries?.AE ?? []).some((e) => e.via === 'dubai_vara')).length;
const adgmCount = exchanges.filter((ex) => (ex.countries?.AE ?? []).some((e) => e.via === 'adgm_manual')).length;
const activeMiCA = exchanges.filter((ex) => ex.eu_status === 'authorised').length;
// One symmetric table for every source we check, EU/EEA included -- MiCA
// used to get its own lead-in sentence above this table while every other
// regime was a row inside it, which read as EU-first-then-everyone-else
// even after the New York DFS gap was fixed. Sorted by count, not by
// EU-then-rest, so the biggest source just naturally sorts first.
const allSources = [
  { cc: null, label: 'EU/EEA (MiCA)', href: '/exchanges/', count: activeMiCA },
  ...nonEEA.map((n) => ({ ...n, href: `/${n.cc.toLowerCase()}/` })),
  { cc: 'AE', label: 'Dubai (VARA)', href: '/ae/', count: varaCount },
  { cc: 'AE', label: 'Abu Dhabi (ADGM, manual)', href: '/ae/', count: adgmCount },
  { cc: 'US', label: 'US (NY DFS BitLicense)', href: '/us/', count: nyDfsCount },
].sort((a, b) => b.count - a.count);

const lastSynced = exchanges
  .flatMap((ex) => ex.sources ?? [])
  .map((s) => s.retrieved)
  .filter(Boolean)
  .sort()
  .at(-1);
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const PAGE_TITLE = 'Crypto Exchange Licensing Stats & Data | whichcryptoexchange.com';
const PAGE_DESC = `Live numbers from our register: ${total} exchanges tracked, ${withGenuineLicence} with a genuine crypto-specific licence, and which jurisdictions and legal entities lead the pack.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <!-- TrustBox script -->
  <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
  <!-- End TrustBox script -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'whichcryptoexchange.com crypto exchange regulatory register',
    description: `Which crypto exchanges hold which regulatory status, in which country, through which legal entity, and since when — sourced from fourteen official regulator registers. ${total} exchanges tracked.`,
    url: 'https://whichcryptoexchange.com/stats/',
    license: 'https://whichcryptoexchange.com/about/',
    dateModified: lastSynced,
    creator: { '@type': 'Organization', name: 'whichcryptoexchange.com', url: 'https://whichcryptoexchange.com' },
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://whichcryptoexchange.com/api/exchanges.json' },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://whichcryptoexchange.com/api/register-snapshot.csv' },
    ],
    variableMeasured: [
      { '@type': 'PropertyValue', name: 'Total exchanges tracked', value: total },
      { '@type': 'PropertyValue', name: 'Exchanges with a genuine crypto-specific licence', value: withGenuineLicence },
      { '@type': 'PropertyValue', name: 'Exchanges with AML-only registration, no genuine licence', value: amlOnly },
      { '@type': 'PropertyValue', name: 'Exchanges tracked in more than one jurisdiction', value: multiJurisdiction },
      { '@type': 'PropertyValue', name: 'Most jurisdictions held by a single brand', value: maxJurisdictions },
      { '@type': 'PropertyValue', name: 'Exchanges with a withdrawn EU MiCA authorisation', value: withdrawn },
      ...genuineByRegime.map((r) => ({ '@type': 'PropertyValue', name: `Exchanges licensed under ${r.label}`, value: r.count })),
    ],
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>Stats</h1>
    <p class="lede">Live numbers computed directly from the register at build time — every figure
    here updates automatically as the underlying data changes. See the
    <a href="/changelog/">changelog</a> for what's new, or pull the
    <a href="/api/register-snapshot.csv">full CSV</a> yourself.</p>

    <p class="sourced">Jump to: <a href="#by-jurisdiction">By jurisdiction</a> ·
    <a href="#by-licence-type">By licence type</a> · <a href="#by-services">By service</a> ·
    <a href="#top-brands">Top brands</a> · <a href="#top-home-states">Top home states</a> ·
    <a href="#data-integrity">Data integrity</a></p>

    {SITEKEY && (
      <div class="digest-cta">
        <h3>Get the weekly regulatory roundup</h3>
        <p>Every status change across every tracked exchange, once a week, straight to your inbox.
        Free, no spam — one email a week, unsubscribe any time.</p>
        <form id="digest-form">
          <div class="digest-cta-row">
            <input type="email" name="email" placeholder="you@example.com" required maxlength="200" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </div>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want the weekly regulatory roundup email. See <a href="/about/">how this works</a> —
            unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </div>
    )}

    <div class="stat-grid">
      <div class="stat-card"><div class="stat-num">{total}</div><div class="stat-label">Exchanges tracked across 14 official registers</div></div>
      <div class="stat-card"><div class="stat-num">{withGenuineLicence}</div><div class="stat-label">Hold at least one genuine crypto-specific licence (EU MiCA, Dubai VARA, Abu Dhabi ADGM, Singapore MAS, Hong Kong SFC, Gibraltar GFSC, Japan FSA, Malaysia SC, or New York DFS)</div></div>
      <div class="stat-card"><div class="stat-num">{amlOnly}</div><div class="stat-label">Hold only AML-supervision registrations, no genuine licence anywhere</div></div>
      <div class="stat-card"><div class="stat-num">{multiJurisdiction}</div><div class="stat-label">Registered or licensed in more than one jurisdiction</div></div>
      <div class="stat-card"><div class="stat-num">{maxJurisdictions}</div><div class="stat-label">Most jurisdictions held by a single brand ({topByJurisdictions[0]?.brand})</div></div>
      <div class="stat-card"><div class="stat-num">{withdrawn}</div><div class="stat-label">Have had an EU MiCA authorisation withdrawn</div></div>
    </div>

    <h3 id="by-jurisdiction">By jurisdiction</h3>
    <p>How many tracked brands appear in each of the 14 official sources we check, all 14 treated
    the same way regardless of size — biggest first:</p>
    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Source</th><th>Exchanges</th></tr></thead>
      <tbody>
        {allSources.map((s) => (
          <tr><td class="brand"><a href={s.href}>{s.label}</a></td><td class="datum">{s.count}</td></tr>
        ))}
      </tbody>
    </table>
    </div>
    <p class="sourced">EU/EEA (MiCA) has no single country page of its own — it's one EU-wide regime
    granted by whichever national regulator is a brand's home state (see the
    <a href="/regulators/#eea">EU/EEA breakdown on the Regulators page</a>) — so it links to the
    full exchange list instead. <strong>{euStatusCounts.withdrawn}</strong> brands have since had
    their MiCA authorisation withdrawn, and <strong>{euStatusCounts.no_eu_entity}</strong> have never
    held one.</p>

    <h3 id="by-licence-type">By licence type</h3>
    <p>By specific genuine licence a brand holds — a brand can hold more than one, e.g. both an EU
    MiCA authorisation and a Dubai VARA licence — biggest first:</p>
    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Licence</th><th>Exchanges</th></tr></thead>
      <tbody>
        {genuineByRegime.map((r) => (
          <tr><td class="brand">{r.cc ? <a href={`/${r.cc.toLowerCase()}/`}>{r.label}</a> : r.label}</td><td class="datum">{r.count}</td></tr>
        ))}
      </tbody>
    </table>
    </div>

    <h3 id="by-services">By MiCA service</h3>
    <p>EU-specific: MiCA is the only regime we track that publishes which specific services
    (custody, trading, exchange, advice, and so on) each authorisation actually covers -- the
    other 11 registers just confirm a status, not a service breakdown. Which authorised
    crypto-asset services are actually most common, across every active (non-withdrawn) EU/EEA
    record:</p>
    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Service</th><th>Authorised entities</th></tr></thead>
      <tbody>
        {servicesSorted.map(([svc, n]) => (
          <tr><td class="brand">{SERVICE_NAMES[svc] ?? svc}</td><td class="datum">{n}</td></tr>
        ))}
      </tbody>
    </table>
    </div>

    <h3 id="top-brands">Most jurisdictions held, by brand</h3>
    <div class="table-controls">
      <label>Sort by
        <select id="sort-brands">
          <option value="jurisdictions-desc">Most jurisdictions first</option>
          <option value="brand">Brand (A–Z)</option>
        </select>
      </label>
    </div>
    <div class="table-scroll">
    <table class="registry" id="table-brands">
      <thead><tr><th>Exchange</th><th>Jurisdictions</th></tr></thead>
      <tbody>
        {topByJurisdictions.map((ex) => (
          <tr data-brand={ex.brand} data-jurisdictions={jurisdictionCount(ex)}>
            <td class="brand"><a href={`/exchange/${ex.id}/`}>{ex.brand}</a></td>
            <td class="datum">{jurisdictionCount(ex)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h3 id="top-home-states">EU/EEA home states</h3>
    <p>Where tracked exchanges are actually headquartered and authorised (their "home state" under
    MiCA passporting), not just where they passport <em>to</em> — all {allHomeStates.length} that
    have at least one home-registered brand:</p>
    <div class="table-controls">
      <label>Sort by
        <select id="sort-states">
          <option value="count-desc">Most entities first</option>
          <option value="country">Country (A–Z)</option>
        </select>
      </label>
    </div>
    <div class="table-scroll">
    <table class="registry" id="table-states">
      <thead><tr><th>Country</th><th>Home-registered entities</th></tr></thead>
      <tbody>
        {allHomeStates.map(([cc, n]) => (
          <tr data-country={COUNTRY_NAMES[cc] ?? cc} data-count={n}>
            <td class="brand"><a href={`/${cc.toLowerCase()}/`}><span class="cc flag">{countryFlag(cc)}</span> {COUNTRY_NAMES[cc] ?? cc}</a></td>
            <td class="datum">{n}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h3 id="data-integrity">A note on data integrity</h3>
    <p>Not every official register is clean. Curating the US FinCEN layer, we found 113 candidate
    filings across 47 brand-name searches — but a large share were shell companies impersonating
    well-known exchange brands (see the <a href="/changelog/">changelog</a> and
    <a href="/us/">US page</a>). Only 29 brands survived independent verification against a real,
    known corporate structure. We'd rather list fewer, verified entries than pad the numbers.</p>

    <p class="sourced">Questions about a number here, or want the underlying data?
    <a href="/contact/">Get in touch</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/reviews/">Reviews</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
    <!-- TrustBox widget - Review Collector -->
    <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="6a79a88069053747f3a86e5d" data-style-height="52px" data-style-width="100%" data-token="4446dd34-abb7-486d-9d18-4cb40eab0921">
      <a href="https://www.trustpilot.com/review/whichcryptoexchange.com" target="_blank" rel="noopener">Trustpilot</a>
    </div>
    <!-- End TrustBox widget -->
    <p class="footer-meta">{stats.brandCount} brands tracked across {stats.jurisdictionCount} jurisdictions · Data last synced {stats.lastSynced} · <a href="/changelog.xml">RSS</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script>
    // Progressive enhancement: rows are already server-rendered in the
    // default order, this just reorders them client-side from data-*
    // attributes, same pattern as the country/exchanges pages.
    const wireSort = (selectId, tableId, sorters) => {
      const select = document.getElementById(selectId);
      const tbody = document.querySelector(`#${tableId} tbody`);
      if (!select || !tbody) return;
      const originalRows = [...tbody.querySelectorAll('tr')];
      select.addEventListener('change', () => {
        const sorter = sorters[select.value];
        const rows = [...originalRows];
        if (sorter) rows.sort(sorter);
        rows.forEach((r) => tbody.appendChild(r));
      });
    };

    wireSort('sort-brands', 'table-brands', {
      'jurisdictions-desc': (a, b) => Number(b.dataset.jurisdictions) - Number(a.dataset.jurisdictions),
      'brand': (a, b) => a.dataset.brand.localeCompare(b.dataset.brand),
    });
    wireSort('sort-states', 'table-states', {
      'count-desc': (a, b) => Number(b.dataset.count) - Number(a.dataset.count),
      'country': (a, b) => a.dataset.country.localeCompare(b.dataset.country),
    });
  </script>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
