---
import { loadExchanges, loadRegulatorDetails, COUNTRY_NAMES, countryFlag } from '../lib/data.js';
import '../styles/global.css';

const exchanges = loadExchanges();
const activeMiCA = exchanges.filter((ex) => ex.eu_status === 'authorised').length;

const sourceRetrieved = (name) => exchanges
  .flatMap((ex) => ex.sources ?? [])
  .filter((s) => s.name === name)
  .map((s) => s.retrieved)
  .sort()
  .at(-1);

const countBrands = (cc) => exchanges.filter((ex) => ex.countries?.[cc]).length;

const NON_EEA_SOURCES = [
  { cc: 'GB', regulator: 'UK Financial Conduct Authority (FCA)', regime: 'MLR registration / separate full authorisation', tier: 'AML-only (mixed)', sourceName: 'UK FCA Register', url: 'https://register.fca.org.uk/' },
  { cc: 'CA', regulator: 'Canada FINTRAC', regime: 'MSB registration', tier: 'AML-only', sourceName: 'Canada FINTRAC MSB Registry', url: 'https://fintrac-canafe.canada.ca/msb-esm/reg-eng' },
  { cc: 'AE', regulator: 'Dubai Virtual Assets Regulatory Authority (VARA)', regime: 'VASP Licence', tier: 'Genuine licence', sourceName: 'Dubai VARA Public Register', url: 'https://www.vara.ae/en/licenses-and-register/public-register/' },
  { cc: 'SG', regulator: 'Singapore Monetary Authority (MAS)', regime: 'MPI Licence (DPT)', tier: 'Genuine licence', sourceName: 'Singapore MAS Financial Institutions Directory', url: 'https://eservices.mas.gov.sg/fid/institution' },
  { cc: 'US', regulator: 'US FinCEN', regime: 'MSB registration', tier: 'AML-only', sourceName: 'US FinCEN MSB Registrant Search', url: 'https://msb.fincen.gov/' },
  { cc: 'HK', regulator: 'Hong Kong Securities and Futures Commission (SFC)', regime: 'VATP Licence', tier: 'Genuine licence', sourceName: 'Hong Kong SFC VATP List', url: 'https://www.sfc.hk/en/Welcome-to-the-Fintech-Contact-Point/Virtual-assets/Virtual-asset-trading-platforms-operators/Lists-of-virtual-asset-trading-platforms' },
  { cc: 'GI', regulator: 'Gibraltar Financial Services Commission (GFSC)', regime: 'DLT Licence', tier: 'Genuine licence (manually verified)', sourceName: 'Gibraltar GFSC DLT Providers List', url: 'https://www.fsc.gi/regulated-entities/dlt-providers-38' },
].map((s) => ({ ...s, count: countBrands(s.cc), retrieved: sourceRetrieved(s.sourceName) }));

// EU/EEA: MiCA is one EU-wide regime, but the actual authorising body is
// each brand's own national home-state regulator -- this is what "browse
// by regulator" means for the EEA side, distinct from browsing by country.
const homeStateRegulators = {};
for (const ex of exchanges) {
  for (const ent of ex.entities ?? []) {
    if (ent.home_state && ent.regulator) {
      const key = ent.home_state;
      (homeStateRegulators[key] ??= { regulator: ent.regulator, count: 0 }).count++;
    }
  }
}
const micaRetrieved = sourceRetrieved('ESMA interim MiCA register (CASPS.csv)');
const eeaRows = Object.entries(homeStateRegulators)
  .map(([cc, v]) => ({ cc, ...v }))
  .sort((a, b) => b.count - a.count);

// "What does each regulator actually check" -- manually researched detail
// (data/regulator_details.yaml), joined against the live brand counts we
// already compute above so the tier/scope/capital writeups sit right next
// to an always-current count and last-checked date, not a stale snapshot.
const regulatorDetails = loadRegulatorDetails().map((d) => ({
  ...d,
  count: d.code === 'MICA' ? activeMiCA : countBrands(d.code),
  retrieved: d.code === 'MICA' ? micaRetrieved : sourceRetrieved(NON_EEA_SOURCES.find((s) => s.cc === d.code)?.sourceName),
}));
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const PAGE_TITLE = 'Crypto Regulators Compared | whichcryptoexchange.com';
const PAGE_DESC = 'What each crypto regulator actually checks -- capital, fit-and-proper, AML -- compared side by side, plus how many tracked brands hold each status right now.';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/logo.jpg" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: NON_EEA_SOURCES.length + eeaRows.length,
    itemListElement: [
      ...NON_EEA_SOURCES.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.regulator,
        url: `https://whichcryptoexchange.com/${s.cc.toLowerCase()}/`,
      })),
      ...eeaRows.map((r, i) => ({
        '@type': 'ListItem',
        position: NON_EEA_SOURCES.length + i + 1,
        name: r.regulator,
        url: `https://whichcryptoexchange.com/${r.cc.toLowerCase()}/`,
      })),
    ],
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>Regulators</h1>
    <p class="lede">The country pages let you browse by where you live. This page flips it around:
    which regulatory body actually granted which status, what that body actually checks before
    granting it, and how many tracked brands sit under each one right now.</p>

    <p class="sourced">Jump to: <a href="#what-they-check">What each regulator checks</a> ·
    <a href="#non-eea">Non-EU/EEA sources</a> · <a href="#eea">EU/EEA national regulators</a></p>

    {SITEKEY && (
      <div class="digest-cta">
        <h3>Get the weekly regulatory roundup</h3>
        <p>Every status change across every tracked exchange, once a week, straight to your inbox.
        Free, no spam — one email a week, unsubscribe any time.</p>
        <form id="digest-form">
          <div class="digest-cta-row">
            <input type="email" name="email" placeholder="you@example.com" required maxlength="200" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </div>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want the weekly regulatory roundup email. See <a href="/about/">how this works</a> —
            unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </div>
    )}

    <h3 id="what-they-check">What each regulator checks</h3>
    <p>"Licensed" means something different in every jurisdiction. Before a status appears
    anywhere on this site, here is what the issuing body actually assesses -- researched against
    each regulator's own published requirements, not marketing copy. Capital figures move over
    time; follow the source link for the current number.</p>

    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Regulator</th><th>Tier</th><th>Scope</th><th>Brands</th><th>Last checked</th></tr></thead>
      <tbody>
        {regulatorDetails.map((d) => (
          <tr>
            <td class="brand"><a href={`#reg-${d.code.toLowerCase()}`}>{d.name}</a></td>
            <td><span class={`stamp ${d.tier}`}>{d.tier_label}</span></td>
            <td class="datum">{d.scope}</td>
            <td class="datum">{d.count}</td>
            <td class="datum">{d.retrieved ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    {regulatorDetails.map((d) => (
      <div class={`record regulator-detail tier-${d.tier}`} id={`reg-${d.code.toLowerCase()}`}>
        <h3>{d.name} <span class={`stamp ${d.tier}`}>{d.tier_label}</span></h3>
        <dl>
          <dt>Scope</dt><dd>{d.scope}</dd>
          <dt>Capital</dt><dd>{d.capital}</dd>
        </dl>
        <p class="checks-label">What it checks:</p>
        <ul>
          {d.checks.map((c) => <li>{c}</li>)}
        </ul>
        {d.note && <p class="sourced">{d.note}</p>}
        <p class="sourced">Source: <a href={d.source_url}>{d.source_url}</a> — reviewed {d.verified}.</p>
      </div>
    ))}

    <h3 id="non-eea">Non-EU/EEA sources</h3>
    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Regulator</th><th>Regime</th><th>Tier</th><th>Brands</th><th>Last checked</th></tr></thead>
      <tbody>
        {NON_EEA_SOURCES.map((s) => (
          <tr>
            <td class="brand"><a href={`/${s.cc.toLowerCase()}/`}>{s.regulator}</a></td>
            <td class="datum">{s.regime}</td>
            <td class="datum">{s.tier}</td>
            <td class="datum">{s.count}</td>
            <td class="datum">{s.retrieved ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h3 id="eea">EU/EEA national regulators (MiCA home-state authorisation)</h3>
    <p>A MiCA authorisation is granted by one national regulator (the brand's "home state") and
    then passports across the whole EU/EEA — the same licence, {eeaRows.length} different
    authorising bodies. Source: <a href="https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica">ESMA interim MiCA register</a>,
    retrieved {micaRetrieved}.</p>
    <div class="table-scroll">
    <table class="registry">
      <thead><tr><th>Country</th><th>Regulator</th><th>Home-registered brands</th></tr></thead>
      <tbody>
        {eeaRows.map((r) => (
          <tr>
            <td class="brand"><a href={`/${r.cc.toLowerCase()}/`}><span class="cc flag">{countryFlag(r.cc)}</span> {COUNTRY_NAMES[r.cc] ?? r.cc}</a></td>
            <td class="datum">{r.regulator}</td>
            <td class="datum">{r.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <p class="sourced">Missing a regulator or a count looks off? <a href="/contact/">Get in touch</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
