---
import { loadExchanges, countriesInData, COUNTRY_NAMES, countryFlag } from '../lib/data.js';
import '../styles/global.css';
const exchanges = loadExchanges();
const countries = countriesInData(exchanges);
const active = exchanges.filter((e) => e.eu_status === 'authorised').length;
const gbExchanges = exchanges.filter((e) => e.countries?.GB);
const gbRegisteredCount = gbExchanges.filter((e) => e.countries.GB.some((g) => g.status === 'registered')).length;
const gbAuthorisedCount = gbExchanges.filter((e) => e.countries.GB.some((g) => g.status === 'authorised')).length;
const caExchanges = exchanges.filter((e) => e.countries?.CA);
const aeExchanges = exchanges.filter((e) => e.countries?.AE);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="impact-site-verification" value="6775223e-6d45-454d-a8db-428c23ccf104" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Which crypto exchange can you use in your country? | whichcryptoexchange.com</title>
  <meta name="description" content={`Check which crypto exchanges are licensed in your country. Built from official regulator registers — currently tracking ${exchanges.length} exchanges across the ESMA MiCA register, the UK FCA Register, the Canada FINTRAC MSB Registry, and Dubai's VARA Public Register.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="logo" href="/">which<em>crypto</em>exchange</a>
    <span class="sourced">source: official regulator registers</span>
  </div></header>

  <main class="wrap">
    <h1>Which crypto exchange can you actually use where you live?</h1>
    <p class="lede">Pick your country. We answer from the official registers — who is licensed,
    through which entity, under which regime, and since when. No rankings, no stars. Receipts.</p>

    <div class="picker">
      <label for="country">Your country of residence</label>
      <select id="country" onchange="if(this.value) location.href='/'+this.value.toLowerCase()+'/'">
        <option value="">Select a country…</option>
        {countries.map((c) => <option value={c}>{COUNTRY_NAMES[c] ?? c}</option>)}
      </select>
    </div>

    <p class="sourced">Currently tracking {exchanges.length} exchanges · {active} with active EU (MiCA) authorisation ·
    data from the <a href="https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica">ESMA interim MiCA register</a></p>
    <p class="sourced">{gbExchanges.length} also have a UK entity on the <a href="https://register.fca.org.uk/">FCA Register</a> ·
    {gbRegisteredCount} MLR-registered · {gbAuthorisedCount} separately FCA-authorised —
    <a href="/gb/">see the UK page</a> for what that distinction means</p>
    <p class="sourced">{caExchanges.length} also have a Canadian entity on the <a href="https://fintrac-canafe.canada.ca/msb-esm/reg-eng">FINTRAC MSB Registry</a> —
    <a href="/ca/">see the Canada page</a></p>
    <p class="sourced">{aeExchanges.length} also hold a Dubai VARA VASP Licence — <strong>Dubai only, not the wider UAE</strong> —
    <a href="/ae/">see the Dubai page</a> for the jurisdiction caveat</p>

    <div class="legend">
      <span class="stamp licensed">EU · MiCA Authorised / Dubai · VARA Licensed</span>
      <span class="stamp gb-registered">UK/CA · Registered</span>
      <span class="stamp gb-authorised">UK · Authorised</span>
    </div>
    <p class="sourced legend-note">MiCA Authorised, Dubai VARA Licensed, and Registered are not all
    equivalent: an EU MiCA authorisation and a Dubai VARA licence are both genuine crypto-specific
    licences (Dubai's covers Dubai only — the UAE has no single national crypto regulator); a UK
    MLR registration or Canada FINTRAC MSB registration is anti-money-laundering supervision only —
    the UK's own cryptoasset licensing regime doesn't open for applications until 30 Sep 2026, and
    Canada has no dedicated cryptoasset licence at all. UK Authorised means a group entity is
    separately, fully FCA-authorised, usually for a different (non-crypto) regulated activity.</p>

    <ul class="country-grid">
      {countries.map((c) => (
        <li><a href={`/${c.toLowerCase()}/`}><span class="cc flag">{countryFlag(c)}</span>{COUNTRY_NAMES[c] ?? c}</a></li>
      ))}
    </ul>
  </main>

  <footer class="site"><div class="wrap">
    <p>whichcryptoexchange.com is an independent register. We are not affiliated with ESMA, the FCA, FINTRAC,
    VARA, or any regulator. Status is drawn from official public registers and may lag regulator updates by up
    to a week. UK entries reflect FCA MLR registration or authorisation, and Canada entries reflect FINTRAC MSB
    registration — neither is a cryptoasset licence, and neither jurisdiction has one yet. Dubai (AE) entries
    reflect a Dubai VARA VASP Licence and cover Dubai only — VARA has no authority over Abu Dhabi, Dubai's own
    DIFC free zone, or the rest of the UAE, and there is no single UAE-wide crypto regulator. Nothing here is
    financial advice.</p>
  </div></footer>

  <script>
    // Geo-suggestion: a Cloudflare Worker sets a `user_country` cookie from
    // CF-IPCountry. If present and we have a page for it, pre-select — never redirect.
    const m = document.cookie.match(/(?:^|;\s*)user_country=([A-Z]{2})/);
    const sel = document.getElementById('country');
    if (m && sel && [...sel.options].some((o) => o.value === m[1])) sel.value = m[1];
  </script>
</body>
</html>
