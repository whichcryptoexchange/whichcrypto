---
import { loadExchanges, countriesInData, COUNTRY_NAMES, countryFlag } from '../lib/data.js';
import '../styles/global.css';
const exchanges = loadExchanges();
const countries = countriesInData(exchanges);
const active = exchanges.filter((e) => e.eu_status === 'authorised').length;
const gbExchanges = exchanges.filter((e) => e.countries?.GB);
const gbRegisteredCount = gbExchanges.filter((e) => e.countries.GB.some((g) => g.status === 'registered')).length;
const gbAuthorisedCount = gbExchanges.filter((e) => e.countries.GB.some((g) => g.status === 'authorised')).length;
const caExchanges = exchanges.filter((e) => e.countries?.CA);
const aeExchanges = exchanges.filter((e) => e.countries?.AE);
const sgExchanges = exchanges.filter((e) => e.countries?.SG);
const usExchanges = exchanges.filter((e) => e.countries?.US);
const hkExchanges = exchanges.filter((e) => e.countries?.HK);
const giExchanges = exchanges.filter((e) => e.countries?.GI);
const jpExchanges = exchanges.filter((e) => e.countries?.JP);
const myExchanges = exchanges.filter((e) => e.countries?.MY);
const krExchanges = exchanges.filter((e) => e.countries?.KR);
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const PAGE_TITLE = 'Is Your Crypto Exchange Licensed? | whichcryptoexchange.com';
const PAGE_DESC = 'Check which crypto exchanges are licensed in your country -- built from 12 official regulator registers (MiCA, FCA, VARA & more). No rankings, just receipts.';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="impact-site-verification" value="6775223e-6d45-454d-a8db-428c23ccf104" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'whichcryptoexchange.com',
    url: 'https://whichcryptoexchange.com',
    logo: 'https://whichcryptoexchange.com/logo.jpg',
    sameAs: ['https://x.com/whichcex'],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'whichcryptoexchange.com',
    url: 'https://whichcryptoexchange.com',
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>Which crypto exchanges are officially registered or licensed where you live?</h1>
    <p class="lede">Pick your country. We answer from the official registers — who is licensed,
    through which entity, under which regime, and since when. No rankings, no stars. Receipts.</p>

    <div class="picker">
      <label for="country">Your country of residence</label>
      <select id="country" onchange="if(this.value) location.href='/'+this.value.toLowerCase()+'/'">
        <option value="">Select a country…</option>
        {countries.map((c) => <option value={c}>{COUNTRY_NAMES[c] ?? c}</option>)}
      </select>
    </div>

    {SITEKEY && (
      <div class="digest-cta">
        <h3>Get the weekly regulatory roundup</h3>
        <p>Every status change across every tracked exchange, once a week, straight to your inbox.
        Free, no spam — one email a week, unsubscribe any time.</p>
        <form id="digest-form">
          <div class="digest-cta-row">
            <input type="email" name="email" placeholder="you@example.com" required maxlength="200" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </div>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want the weekly regulatory roundup email. See <a href="/about/">how this works</a> —
            unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </div>
    )}

    <div class="record reports-widget">
      <h3>Latest user reports</h3>
      <p class="sourced">Community-sourced and reviewed before publication — kept strictly separate
      from the regulator-sourced data above. Browse any <a href="/exchanges/">exchange's own page</a>
      to report your own experience signing up, verifying, or withdrawing.</p>
      <div id="latest-reports-list"><p class="sourced">Loading reports…</p></div>
    </div>

    <h3>Coverage by jurisdiction</h3>
    <p class="sourced">Currently tracking {exchanges.length} exchanges · {active} with active EU
    (MiCA) authorisation, per the <a href="https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica">ESMA interim MiCA register</a>.
    Beyond the EU/EEA, the same brands are cross-checked against these official sources:</p>
    <ul class="sourced jurisdiction-list">
      <li><strong>{gbExchanges.length}</strong> have a UK entity on the <a href="https://register.fca.org.uk/">FCA Register</a>
      — {gbRegisteredCount} MLR-registered, {gbAuthorisedCount} separately FCA-authorised.
      <a href="/gb/">See the UK page</a> for what that distinction means.</li>
      <li><strong>{caExchanges.length}</strong> have a Canadian entity on the <a href="https://fintrac-canafe.canada.ca/msb-esm/reg-eng">FINTRAC MSB Registry</a>.
      <a href="/ca/">See the Canada page</a>.</li>
      <li><strong>{aeExchanges.length}</strong> hold a Dubai VARA VASP licence — <strong>Dubai only,
      not the wider UAE</strong>. <a href="/ae/">See the Dubai page</a> for the jurisdiction caveat.</li>
      <li><strong>{sgExchanges.length}</strong> hold a Singapore MAS Major Payment Institution licence
      for Digital Payment Token services. <a href="/sg/">See the Singapore page</a>.</li>
      <li><strong>{usExchanges.length}</strong> have a US entity on the <a href="https://msb.fincen.gov/">FinCEN MSB Registrant Search</a>.
      <a href="/us/">See the US page</a> for the fraud-shell caveat.</li>
      <li><strong>{hkExchanges.length}</strong> hold a Hong Kong SFC Virtual Asset Trading Platform
      licence. <a href="/hk/">See the Hong Kong page</a>.</li>
      <li><strong>{giExchanges.length}</strong> hold a Gibraltar DLT licence. <a href="/gi/">See the
      Gibraltar page</a> — manually verified, not on an automated schedule.</li>
      <li><strong>{jpExchanges.length}</strong> hold a Japan FSA Crypto-asset Exchange Service
      Provider registration. <a href="/jp/">See the Japan page</a>.</li>
      <li><strong>{myExchanges.length}</strong> hold a Malaysia SC Recognized Market Operator -
      Digital Asset Exchange registration. <a href="/my/">See the Malaysia page</a>.</li>
      <li><strong>{krExchanges.length}</strong> have a South Korean entity registered with the FIU
      under the Act on Reporting and Using Specified Financial Transaction Information.
      <a href="/kr/">See the South Korea page</a>.</li>
    </ul>

    <h3>How to read the badges</h3>
    <div class="legend">
      <span class="stamp licensed">MiCA / VARA / MAS / SFC / DLT / FSA / SC — Licensed</span>
      <span class="stamp gb-registered">UK/CA/US/KR · Registered</span>
      <span class="stamp gb-authorised">UK · Authorised</span>
    </div>
    <ul class="sourced legend-note">
      <li><strong>Licensed</strong> means a genuine crypto-specific licence: EU MiCA, Dubai VARA,
      Singapore MAS, Hong Kong SFC, Gibraltar DLT, Japan FSA, or Malaysia SC. Dubai's covers Dubai
      only — the UAE has no single national crypto regulator. Gibraltar's is the only source on this
      site we can't automatically sync — see the Gibraltar page.</li>
      <li><strong>Registered</strong> (UK, Canada, US, South Korea) means anti-money-laundering
      supervision only, not a licence. The UK's own cryptoasset licensing regime doesn't open for
      applications until 30 Sep 2026, and none of Canada, the US, or South Korea has a dedicated
      cryptoasset licence at all — the US also has separate, unmapped state-level money transmitter
      regimes.</li>
      <li><strong>UK Authorised</strong> means a group entity is separately, fully FCA-authorised,
      usually for a different, non-crypto regulated activity.</li>
      <li>Some Singapore-licensed brands (Anchorage Digital, HashKey, Paxos, Upbit, Independent
      Reserve) have no EU entity at all and appear only on the Singapore page.</li>
    </ul>

    <h3>Browse by country</h3>
    <ul class="country-grid">
      {countries.map((c) => (
        <li><a href={`/${c.toLowerCase()}/`}><span class="cc flag">{countryFlag(c)}</span>{COUNTRY_NAMES[c] ?? c}</a></li>
      ))}
    </ul>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>whichcryptoexchange.com is an independent register. We are not affiliated with ESMA, the FCA, FINTRAC,
    VARA, MAS, FinCEN, the SFC, the GFSC, the FSA, the SC, the FIU, or any regulator. Status is drawn from
    official public registers and may lag regulator updates by up to a week — except Gibraltar, which is
    manually verified rather than synced on a schedule (see the Gibraltar page). UK entries reflect FCA MLR
    registration or authorisation, Canada entries reflect FINTRAC MSB registration, US entries reflect FinCEN
    MSB registration, and South Korea entries reflect FIU VASP registration — none of these four is a
    cryptoasset licence, and none of the four jurisdictions has one yet. Dubai (AE) entries reflect a Dubai
    VARA VASP licence and cover Dubai only — VARA has no authority over Abu Dhabi, Dubai's own DIFC free zone,
    or the rest of the UAE, and there is no single UAE-wide crypto regulator. Singapore entries reflect a MAS
    Major Payment Institution licence for Digital Payment Token services. Hong Kong entries reflect an SFC
    Virtual Asset Trading Platform licence. Gibraltar entries reflect a GFSC DLT licence. Japan entries reflect
    an FSA Crypto-asset Exchange Service Provider registration under the Payment Services Act. Malaysia
    entries reflect an SC Recognized Market Operator - Digital Asset Exchange registration under the Capital
    Markets and Services Act. Nothing here is financial advice.</p>
  </div></footer>

  <script>
    // Geo-suggestion: a Cloudflare Worker sets a `user_country` cookie from
    // CF-IPCountry. If present and we have a page for it, pre-select — never redirect.
    const m = document.cookie.match(/(?:^|;\s*)user_country=([A-Z]{2})/);
    const sel = document.getElementById('country');
    if (m && sel && [...sel.options].some((o) => o.value === m[1])) sel.value = m[1];

    // Latest user reports: fetched client-side because the page is static.
    // Same source data as each exchange's own "User reports" section --
    // approved reports only, and never the free-text detail field.
    const reportsList = document.getElementById('latest-reports-list');
    fetch('/api/reports/latest')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d) => {
        if (!d.rows.length) { reportsList.innerHTML = '<p class="sourced">No published reports yet.</p>'; return; }
        reportsList.innerHTML = d.rows.map((r) =>
          `<p><a href="/exchange/${r.exchange_id}/#reports">${r.brand}</a> — ` +
          `<span class="datum">${r.country}</span> — ${d.labels[r.outcome] ?? r.outcome} ` +
          `<span class="sourced">${r.created_at.slice(0, 10)}</span></p>`
        ).join('');
      })
      .catch(() => { reportsList.innerHTML = '<p class="sourced">Reports unavailable right now.</p>'; });
  </script>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
