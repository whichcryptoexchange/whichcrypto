---
import { loadExchanges } from '../lib/data.js';
import '../styles/global.css';

const exchanges = loadExchanges();
const sourceRetrieved = (name) => exchanges
  .flatMap((ex) => ex.sources ?? [])
  .filter((s) => s.name === name)
  .map((s) => s.retrieved)
  .sort()
  .at(-1);

const SOURCES = [
  { name: 'ESMA interim MiCA register (CASPS.csv)', label: 'ESMA MiCA register', url: 'https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica' },
  { name: 'UK FCA Register', label: 'UK FCA Register', url: 'https://register.fca.org.uk/' },
  { name: 'Canada FINTRAC MSB Registry', label: 'Canada FINTRAC MSB Registry', url: 'https://fintrac-canafe.canada.ca/msb-esm/reg-eng' },
  { name: 'Dubai VARA Public Register', label: 'Dubai VARA Public Register', url: 'https://www.vara.ae/en/licenses-and-register/public-register/' },
  { name: 'Singapore MAS Financial Institutions Directory', label: 'Singapore MAS Financial Institutions Directory', url: 'https://eservices.mas.gov.sg/fid/institution' },
  { name: 'US FinCEN MSB Registrant Search', label: 'US FinCEN MSB Registrant Search', url: 'https://msb.fincen.gov/' },
  { name: 'Hong Kong SFC VATP List', label: 'Hong Kong SFC VATP List', url: 'https://www.sfc.hk/en/Welcome-to-the-Fintech-Contact-Point/Virtual-assets/Virtual-asset-trading-platforms-operators/Lists-of-virtual-asset-trading-platforms' },
  { name: 'Gibraltar GFSC DLT Providers List', label: 'Gibraltar GFSC DLT Providers List (manually verified)', url: 'https://www.fsc.gi/regulated-entities/dlt-providers-38' },
].map((s) => ({ ...s, retrieved: sourceRetrieved(s.name) }));
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>About | whichcryptoexchange.com</title>
  <meta name="description" content="How whichcryptoexchange.com works: which official registers we draw from, how brands are curated, and what 'licensed' does and doesn't mean in each jurisdiction." />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>About</h1>
    <p class="lede">Which crypto exchange can you actually use where you live? We answer that from
    official regulator registers only — no rankings, no stars. The regulator data is never
    influenced by commercial relationships. Receipts.</p>

    <h3>What this is</h3>
    <p>whichcryptoexchange.com is an independent register of which crypto exchanges and related
    firms hold which regulatory status, in which country, through which legal entity, and since
    when. Every status shown here traces back to a specific official source — click through and
    verify it yourself.</p>

    <h3>Where the data comes from</h3>
    <p>We currently draw from eight official sources, each with its own regime and its own meaning
    of "licensed" (or, in some cases, deliberately <em>not</em> licensed):</p>
    <ul>
      <li><strong>ESMA</strong> — the interim MiCA register covering the EU/EEA. A MiCA
      authorisation is a full crypto-specific licence.</li>
      <li><strong>UK FCA Register</strong> — most UK crypto firms hold only an anti-money-laundering
      MLR <em>registration</em>, not a licence. The UK's own dedicated cryptoasset licensing regime
      doesn't open for applications until 30 Sep 2026. A smaller number of brands also have a UK
      entity that's separately, fully FCA-authorised — usually for a different, non-crypto
      activity.</li>
      <li><strong>Canada FINTRAC MSB Registry</strong> — Money Services Business registration is
      anti-money-laundering supervision only, not a licence. Canada has no dedicated cryptoasset
      licensing regime. Platforms may also need CIRO investment-dealer or provincial
      securities-dealer registration — we don't cover that layer, since the CSA's and CIRO's own
      registrant-lookup tools block automated access outright.</li>
      <li><strong>Dubai VARA Public Register</strong> — a genuine crypto-specific licence, but it
      covers Dubai only. VARA has no authority over Abu Dhabi, Dubai's own DIFC free zone, or the
      rest of the UAE — there is no single UAE-wide crypto regulator.</li>
      <li><strong>Singapore MAS Financial Institutions Directory</strong> — a genuine crypto-specific
      licence (Major Payment Institution, Digital Payment Token Service activity) under the Payment
      Services Act 2019.</li>
      <li><strong>US FinCEN MSB Registrant Search</strong> — Money Services Business registration
      under the Bank Secrecy Act is anti-money-laundering supervision only, not a licence. The US
      also has no single national register for state-level money transmitter licensing (up to 50
      separate state regimes), so that layer isn't covered here. FinCEN's own register also has a
      real fraud problem — its search page warns that scammers register shell companies under
      recognisable brand names to appear "FinCEN approved". We found and excluded a cluster of
      exactly that pattern during curation; only entries independently matched to a brand's real
      corporate structure are listed.</li>
      <li><strong>Hong Kong SFC VATP List</strong> — a Virtual Asset Trading Platform licence is a
      genuine crypto-specific licence, mandatory since 2023 under the Securities and Futures
      Ordinance — the same tier as Dubai's VARA licence and Singapore's MAS licence. The SFC also
      publishes separate lists of applicants, returned/refused/withdrawn applicants, and
      closing-down platforms; only the formally licensed list is used here.</li>
      <li><strong>Gibraltar GFSC DLT Providers List</strong> — a Distributed Ledger Technology (DLT)
      Licence is a genuine crypto-specific licence, the same tier as VARA/MAS/SFC. This is the one
      source on this site we cannot automatically sync: the GFSC's own register sits behind bot
      protection that blocks scripted access outright, so this list is refreshed only when someone
      manually re-checks the live page in a browser — it can lag more than every other source
      here.</li>
    </ul>
    <p>Each exchange page cites every source that applies to it, with the date we last checked.</p>

    <h3>Data freshness</h3>
    <p>Each source syncs on its own schedule via an automated pull request we review before
    merging — see each source's own page for exact cadence. Last synced, per source:</p>
    <ul class="sourced">
      {SOURCES.map((s) => (
        <li><a href={s.url}>{s.label}</a> — {s.retrieved ?? 'not yet synced'}</li>
      ))}
    </ul>
    <p>Want the full dataset? <a href="/api/exchanges.json">JSON</a> ·
    <a href="/api/register-snapshot.csv">CSV snapshot</a> · see what's changed on the
    <a href="/changelog/">changelog</a>.</p>

    <h3>How brands get curated</h3>
    <p>Official registers list legal entities — "Payward Europe Solutions Limited" — not consumer
    brands — "Kraken." We manually map legal entities to the brand name people actually search for,
    and consolidate multiple entities from the same corporate group where that's clearly correct
    (e.g. a broker entity and a separate custody entity under the same brand). Where a brand has no
    entity in a given source at all, it simply isn't listed there — we don't guess.</p>

    <h3>Email alerts</h3>
    <p>Exchange pages have a "watch this exchange" option — enter your email to be notified if
    that brand's regulatory status changes. It's double opt-in: nothing is created until you click
    the confirmation link sent to your inbox, and every alert email has a one-click unsubscribe
    link, no login needed. We store only your email address and which brand(s) you're watching —
    never shared with the exchange itself or any third party, and deleted immediately on
    unsubscribe. A status-change alert is not financial advice and doesn't imply anything got
    better or worse — only that the register entry changed.</p>

    <h3>User reports</h3>
    <p>Alongside the regulator-sourced data, exchange pages carry a community-reported section —
    real people's real signup/withdrawal experiences, submitted through a form, held for manual
    review before publication, and always displayed separately from the regulator data above it.
    We never merge the two.</p>

    <h3>Affiliate links</h3>
    <p>Some exchange pages show a "Visit" button that's an affiliate link — we may earn a
    commission if you sign up through it, at no extra cost to you. It's always labelled as an
    affiliate link right next to the button, never hidden in the regulator data above it. Whether
    a brand has an affiliate link has no bearing on its licensing status, its stamps, or anything
    else on the page — that data comes from the official sources listed above regardless of any
    commercial relationship.</p>

    <h3>What we're not</h3>
    <p>We are not affiliated with ESMA, the FCA, FINTRAC, VARA, MAS, or any regulator, exchange, or
    financial institution mentioned on this site. Nothing here is financial advice. Status can lag
    the official registers by up to a week between our sync runs.</p>

    <p class="sourced">Questions, corrections, or something looks wrong? <a href="/contact/">Get in touch</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script src="/search.js" defer></script>
</body>
</html>
