---
import { loadExchanges, loadTaxDeadlines, footerStats } from '../lib/data.js';
import '../styles/global.css';
// Turnstile site keys are public by design (embedded in client HTML), so hardcoding
// this as a fallback is safe. The env var still wins if the build environment sets it.
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const stats = footerStats(loadExchanges());
const deadlines = loadTaxDeadlines();
const PAGE_TITLE = 'UK Crypto Tax Deadline Reminders | whichcryptoexchange.com';
const PAGE_DESC = 'Free email reminders for UK Self Assessment deadlines relevant to crypto holders, plus occasional alerts if the rules change. Not tax advice -- dated, sourced heads-ups.';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <!-- X conversion tracking base code -->
  <script>
  !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);
  },s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='https://static.ads-twitter.com/uwt.js',
  a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a))}(window,document,'script');
  twq('config','ref28');
  </script>
  <!-- End X conversion tracking base code -->
  <!-- TrustBox script -->
  <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
  <!-- End TrustBox script -->
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
      <a href="/news/">News</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>UK crypto tax deadline reminders</h1>
    <p class="lede">Free email reminders ahead of UK Self Assessment deadlines relevant to crypto
    holders, plus occasional emails if the rules actually change. This is <strong>not</strong>
    personalised tax advice — just dated, sourced heads-ups, the same editorial discipline as the
    rest of this register.</p>

    <h3>Why now — HMRC's Cryptoasset Reporting Framework</h3>
    <p>From 1 January 2026, UK crypto exchanges and other "reporting cryptoasset service
    providers" are required to collect user and transaction data under HMRC's Cryptoasset
    Reporting Framework (CARF) — an OECD-developed global standard, implemented in UK law via
    <a href="https://www.legislation.gov.uk/uksi/2025/744/made">Statutory Instrument 2025/744</a>.
    Reporting cryptoasset service providers must register with HMRC by 31 May 2027 at the latest,
    and their first reports — covering all of 2026 — are due to HMRC by that same date. See
    <a href="https://www.gov.uk/guidance/collecting-cryptoasset-user-and-transaction-data">HMRC's
    own guidance</a> for the full detail. Practically: if you hold or trade crypto in the UK, your
    exchange is very likely already collecting the data behind this.</p>

    <h3>The recurring deadlines this list reminds you about</h3>
    <ul class="tax-deadline-list">
      {deadlines.map((d) => (
        <li>
          <strong>{d.label}</strong> — {String(d.day).padStart(2, '0')}/{String(d.month).padStart(2, '0')} every year
          {d.detail && <p class="sourced">{d.detail}</p>}
          <p class="sourced">Source: <a href={d.source}>{d.source}</a></p>
        </li>
      ))}
    </ul>

    {SITEKEY ? (
      <form id="tax-reminder-form" class="report-form">
        <label>Your email
          <input type="email" name="email" required maxlength="200" />
        </label>
        <label class="consent-label">
          <input type="checkbox" name="consent" required />
          I want occasional email reminders about UK crypto tax deadlines, and alerts if the rules
          change. Unsubscribe any time, no login needed.
        </label>
        <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
        <button type="submit" id="tax-reminder-submit-btn">Subscribe</button>
        <p class="form-msg sourced" role="status"></p>
      </form>
    ) : (
      <p class="sourced">The signup form is opening soon — in the meantime, email
      contact@whichcryptoexchange.com directly.</p>
    )}
  </main>

  <footer class="site"><div class="wrap">
    <div class="footer-top">
      <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/reviews/">Reviews</a> · <a href="/news/">News</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
      <!-- TrustBox widget - Review Collector -->
      <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="6a79a88069053747f3a86e5d" data-style-height="52px" data-style-width="100%" data-token="4446dd34-abb7-486d-9d18-4cb40eab0921">
        <a href="https://www.trustpilot.com/review/whichcryptoexchange.com" target="_blank" rel="noopener">Trustpilot</a>
      </div>
      <!-- End TrustBox widget -->
    </div>
    <p class="footer-meta">{stats.brandCount} brands tracked across {stats.jurisdictionCount} jurisdictions · Data last synced {stats.lastSynced} · <a href="/changelog.xml">RSS</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
