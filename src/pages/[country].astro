---
import { loadExchanges, loadRegulatorDetails, countriesInData, COUNTRY_NAMES, SERVICE_NAMES, footerStats } from '../lib/data.js';
import { buildFaqEntries } from '../lib/faq.js';
import '../styles/global.css';

export function getStaticPaths() {
  const exchanges = loadExchanges();
  // Built once here rather than per-page -- each country page only needs
  // its own single "which exchanges are licensed in X" entry for FAQPage
  // schema, not the full ~445-entry index.
  const faqEntries = buildFaqEntries(exchanges, loadRegulatorDetails());
  const stats = footerStats(exchanges);
  return countriesInData(exchanges).map((c) => ({
    params: { country: c.toLowerCase() },
    props: { code: c, exchanges, faqEntry: faqEntries.find((e) => e.id === `country-${c.toLowerCase()}`), stats },
  }));
}

const { code, exchanges, faqEntry, stats } = Astro.props;
const name = COUNTRY_NAMES[code] ?? code;
// Non-EEA jurisdictions store a LIST of entries per country (a brand can have
// more than one relevant entity/tier), unlike the single-object EEA/MiCA shape.
const isGB = code === 'GB';
const isCA = code === 'CA';
const isAE = code === 'AE';
const isSG = code === 'SG';
const isUS = code === 'US';
const isHK = code === 'HK';
const isGI = code === 'GI';
const isJP = code === 'JP';
const isMY = code === 'MY';
const isKR = code === 'KR';
const isNZ = code === 'NZ';
const isNonEEA = isGB || isCA || isAE || isSG || isUS || isHK || isGI || isJP || isMY || isKR || isNZ;
const rows = exchanges
  .map((ex) => ({ ex, c: ex.countries?.[code] }))
  .filter((r) => r.c);
const sourceRetrieved = (name_) => exchanges
  .flatMap((ex) => ex.sources ?? [])
  .find((s) => s.name === name_)?.retrieved;
const fcaRetrieved = sourceRetrieved('UK FCA Register');
const fintracRetrieved = sourceRetrieved('Canada FINTRAC MSB Registry');
const varaRetrieved = sourceRetrieved('Dubai VARA Public Register');
const adgmRetrieved = sourceRetrieved('ADGM FSRA Public Register');
const masRetrieved = sourceRetrieved('Singapore MAS Financial Institutions Directory');
const fincenRetrieved = sourceRetrieved('US FinCEN MSB Registrant Search');
const nyDfsRetrieved = sourceRetrieved('NY DFS List of Licensed Virtual Currency Entities');
const sfcRetrieved = sourceRetrieved('Hong Kong SFC VATP List');
const gfscRetrieved = sourceRetrieved('Gibraltar GFSC DLT Providers List');
const jpFsaRetrieved = sourceRetrieved('Japan FSA Registered Crypto-asset Exchange Service Providers List');
const myScRetrieved = sourceRetrieved('Malaysia SC List of Registered Digital Asset Exchanges');
const krFiuRetrieved = sourceRetrieved('Korea FIU VASP Registration Disclosure');
const nzFsprRetrieved = sourceRetrieved('New Zealand FSPR');
// registered/authorised (UK, CA) are AML-only tiers; licensed (AE/Dubai VARA)
// is a genuine crypto-specific licence, so it gets the same green stamp as
// EU MiCA rather than the cautious amber/grey UK-style tiers.
const STATUS_STAMP = {
  registered: { cls: 'gb-registered', label: 'Registered' },
  authorised: { cls: 'gb-authorised', label: 'Authorised' },
  licensed: { cls: 'licensed', label: 'Licensed' },
};
// "Jurisdictions" is a brand-wide fact (how many countries.* keys it has
// across every source), not specific to this page's country — a genuine
// regulatory fact (more registers saying yes), not a popularity guess.
const jurisdictionCount = (ex) => Object.keys(ex.countries ?? {}).length;
// Only show the tier filter (Registered vs Authorised vs Licensed) when a
// page actually mixes more than one tier — GB does (both), CA/AE/SG don't.
const tiersOnPage = isNonEEA
  ? [...new Set(rows.flatMap(({ c }) => c.map((e) => e.status)))]
  : [];
const YEAR = new Date().getFullYear();
const PAGE_TITLE = isGB
  ? `UK Crypto Exchanges: Registered or Authorised | whichcryptoexchange.com`
  : isCA
  ? `Crypto exchanges registered in Canada (${YEAR}) | whichcryptoexchange.com`
  : isAE
  ? `Crypto exchanges licensed in Dubai or Abu Dhabi (${YEAR}) | whichcryptoexchange.com`
  : isSG
  ? `Crypto exchanges licensed in Singapore (${YEAR}) | whichcryptoexchange.com`
  : isUS
  ? `US Crypto Exchanges: FinCEN Registered or NY DFS Licensed | whichcryptoexchange.com`
  : isHK
  ? `Crypto exchanges licensed in Hong Kong (${YEAR}) | whichcryptoexchange.com`
  : isGI
  ? `Crypto exchanges licensed in Gibraltar (${YEAR}) | whichcryptoexchange.com`
  : isJP
  ? `Crypto exchanges licensed in Japan (${YEAR}) | whichcryptoexchange.com`
  : isMY
  ? `Crypto exchanges licensed in Malaysia (${YEAR}) | whichcryptoexchange.com`
  : isKR
  ? `Crypto exchanges registered in South Korea (${YEAR}) | whichcryptoexchange.com`
  : isNZ
  ? `Crypto exchanges registered in New Zealand (${YEAR}) | whichcryptoexchange.com`
  : `Crypto exchanges licensed in ${name} (${YEAR}) | whichcryptoexchange.com`;
const PAGE_DESC = isGB
  ? `${rows.length} crypto exchanges hold a UK FCA registration or authorisation, according to the official FCA Register. See which entity, which regime, and since when.`
  : isCA
  ? `${rows.length} crypto exchanges hold a Canada FINTRAC MSB registration, according to the official FINTRAC registry. See which entity and since when.`
  : isAE
  ? `${rows.length} crypto exchanges hold a Dubai VARA VASP licence or an Abu Dhabi ADGM FSRA licence — not the rest of the UAE. See which entity, which activities, and since when.`
  : isSG
  ? `${rows.length} crypto exchanges hold a MAS Major Payment Institution licence for Digital Payment Token services, according to the official MAS Financial Institutions Directory.`
  : isUS
  ? `${rows.length} crypto exchanges hold a US FinCEN MSB registration and/or a genuine NY DFS virtual currency licence or trust charter. See which entity, which regime, and since when.`
  : isHK
  ? `${rows.length} crypto exchanges hold a Hong Kong SFC Virtual Asset Trading Platform licence, according to the official SFC list. See which entity and since when.`
  : isGI
  ? `${rows.length} crypto exchanges hold a Gibraltar DLT licence, according to the GFSC's DLT Providers list.`
  : isJP
  ? `${rows.length} crypto exchanges hold a Japan FSA Crypto-asset Exchange Service Provider registration, according to the FSA's official registered list.`
  : isMY
  ? `${rows.length} crypto exchanges hold a Malaysia SC Recognized Market Operator - Digital Asset Exchange registration, according to the SC's official registered list.`
  : isKR
  ? `${rows.length} crypto exchanges hold a Korea FIU VASP registration, according to the FIU's official registration disclosure.`
  : isNZ
  ? `${rows.length} crypto exchanges hold a New Zealand FSPR registration, manually verified against the official Financial Service Providers Register.`
  : `${rows.length} crypto exchanges hold a licence covering ${name}, according to official regulator registers. See which entity, which regime, and since when.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'whichcryptoexchange.com', item: 'https://whichcryptoexchange.com/' },
      { '@type': 'ListItem', position: 2, name, item: `https://whichcryptoexchange.com/${code.toLowerCase()}/` },
    ],
  })} />
  {faqEntry && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [{
        '@type': 'Question',
        name: faqEntry.question,
        acceptedAnswer: { '@type': 'Answer', text: faqEntry.answer },
      }],
    })} />
  )}
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
    </div></nav>
  </header>

  <main class="wrap">
    {isGB ? (
      <>
        <h1>Which crypto exchanges are registered or authorised in the UK?</h1>
        <p class="lede">{rows.length} exchanges in our register have a UK entity on the FCA Register.
        The UK does not yet have a dedicated cryptoasset licensing regime — that opens for
        applications 30 Sep 2026 and is expected to start 25 Oct 2027. Until then, most UK crypto
        entities hold only an anti-money-laundering <strong>MLR registration</strong>, which is
        <em> not</em> the same as a licence: it means the FCA supervises the firm for financial
        crime purposes, not that the FCA has assessed or approved its products or conduct. A
        smaller number of tracked brands also have a UK entity that is separately, fully
        <strong> FCA-authorised</strong> — a broader regulatory regime overall, but typically for a
        different activity (e.g. derivatives or general investment business) than the crypto
        exchange itself. Both tiers are shown below, clearly labelled.</p>
      </>
    ) : isCA ? (
      <>
        <h1>Which crypto exchanges are registered in Canada?</h1>
        <p class="lede">{rows.length} exchanges in our register have a Canadian entity registered
        with FINTRAC as a Money Services Business (MSB) offering virtual currency services. As
        FINTRAC's own registry states, this is <em>not</em> a licence: registration means FINTRAC
        supervises the firm for anti-money-laundering purposes, not that it has assessed or
        approved the firm's products or conduct. Crypto trading platforms serving Canadians may
        also need separate registration as an investment dealer with CIRO (Canada's national
        self-regulatory body) or as a securities dealer with a provincial regulator — that data
        isn't covered here. The CSA's and CIRO's own registrant-lookup tools block automated
        access outright, so unlike the sources above, there's no reliable way to keep this layer
        current from our end.</p>
      </>
    ) : isAE ? (
      <>
        <h1>Which crypto exchanges are licensed in Dubai or Abu Dhabi?</h1>
        <p class="lede caveat">This page covers two of the UAE's free zones, not the UAE as a
        whole: Dubai's VARA and Abu Dhabi Global Market's FSRA. Dubai's own DIFC free zone
        (regulated separately by the DFSA) and the federal mainland (regulated by the SCA) are
        still not covered — there is no single UAE-wide crypto regulator.</p>
        <p class="lede">{rows.length} exchanges in our register hold a VARA VASP licence, issued by
        Dubai's Virtual Assets Regulatory Authority, or an ADGM FSRA licence, issued by Abu Dhabi
        Global Market's Financial Services Regulatory Authority. Unlike the UK and Canada entries
        elsewhere on this site, both <em>are</em> genuine crypto-specific licences — each built a
        dedicated regulatory regime for virtual assets from scratch, not an AML add-on to existing
        rules.</p>
        <p class="lede caveat">The ADGM entries are manually verified, not automatically synced —
        its register sits behind bot protection our scripts can't get through, same as Gibraltar.
        Each one was checked individually against its own regulatory announcement, and the list
        isn't necessarily complete; ADGM has reportedly authorised 30+ virtual asset firms in
        total.</p>
      </>
    ) : isSG ? (
      <>
        <h1>Which crypto exchanges are licensed in Singapore?</h1>
        <p class="lede">{rows.length} exchanges in our register hold a Major Payment Institution
        licence from the Monetary Authority of Singapore (MAS), specifically for the Digital
        Payment Token Service activity under the Payment Services Act 2019. Like Dubai's VARA
        licence, this <em>is</em> a genuine crypto-specific licence — not an AML-only registration
        like the UK/Canada entries elsewhere on this site.</p>
      </>
    ) : isUS ? (
      <>
        <h1>Which crypto exchanges are registered or licensed in the US?</h1>
        <p class="lede">This page covers two separate, independent regimes. Most brands here have a
        US entity registered with FinCEN as a Money Services Business (MSB) offering money
        transmission — as with Canada's FINTRAC registry, this is <em>not</em> a licence:
        registration means FinCEN supervises the firm for anti-money-laundering purposes under the
        Bank Secrecy Act, not that it has assessed or approved the firm's products or conduct. Some
        brands additionally (or instead) hold a genuine state-level licence from the New York
        Department of Financial Services — either a Virtual Currency License ("BitLicense") or a
        Limited Purpose Trust Charter — which <em>is</em> a real crypto-specific licence, not an
        AML-only registration. Crypto firms serving US customers may also need separate money
        transmitter licensing in the other 49 states, which isn't covered here, since none of them
        publish a single, checkable public register the way NYDFS does.</p>
        <p class="lede caveat">FinCEN's own register has a real fraud problem: its MSB Registrant
        Search prominently warns that fraudsters register shell companies using recognisable brand
        names to appear "FinCEN approved". We found and excluded a large cluster of exactly that —
        near-identical shell filings claiming names like "Crypto.com Exchange Ltd" or "Interactive
        Brokers Inc." out of a small number of Colorado addresses. Only entries independently
        matched to a brand's real, known corporate structure are listed below.</p>
      </>
    ) : isHK ? (
      <>
        <h1>Which crypto exchanges are licensed in Hong Kong?</h1>
        <p class="lede">{rows.length} exchanges in our register hold a Virtual Asset Trading
        Platform (VATP) licence from Hong Kong's Securities and Futures Commission (SFC), mandatory
        since 2023 under the Securities and Futures Ordinance. Like Dubai's VARA licence and
        Singapore's MAS licence, this <em>is</em> a genuine crypto-specific licence — not an
        AML-only registration like the UK/Canada/US entries elsewhere on this site. The SFC also
        publishes separate lists of applicants, returned/refused/withdrawn applicants, and
        closing-down platforms — only the formally licensed list is shown here.</p>
      </>
    ) : isGI ? (
      <>
        <h1>Which crypto exchanges are licensed in Gibraltar?</h1>
        <p class="lede">{rows.length} exchanges in our register hold a Distributed Ledger
        Technology (DLT) licence from the Gibraltar Financial Services Commission (GFSC) — a
        genuine crypto-specific licence, not an AML-only registration.</p>
        <p class="lede caveat">Unlike every other jurisdiction on this site, this one is not
        automatically synced. The GFSC's own register sits behind bot protection that blocks
        scripted access outright, so this list is refreshed only when someone manually re-checks
        the live page in a browser — it can lag more than the weekly-synced sources elsewhere.</p>
      </>
    ) : isJP ? (
      <>
        <h1>Which crypto exchanges are licensed in Japan?</h1>
        <p class="lede">{rows.length} exchanges in our register hold a Crypto-asset Exchange Service
        Provider registration from Japan's Financial Services Agency (FSA), under the Payment
        Services Act — in force since 2017, one of the earliest dedicated crypto-exchange licensing
        regimes anywhere. Like Dubai's VARA licence and Singapore's MAS licence, this <em>is</em> a
        genuine crypto-specific licence — it requires segregated custody of user funds (at least
        95% held offline), annual audits, and JVCEA self-regulatory membership, not just an
        AML-only registration.</p>
      </>
    ) : isMY ? (
      <>
        <h1>Which crypto exchanges are licensed in Malaysia?</h1>
        <p class="lede">{rows.length} exchanges in our register hold a Recognized Market Operator -
        Digital Asset Exchange (RMO-DAX) registration from Malaysia's Securities Commission (SC),
        under the Capital Markets and Services Act. Like Dubai's VARA licence and Singapore's MAS
        licence, this <em>is</em> a genuine crypto-specific licence — it requires a minimum of
        RM5,000,000 paid-up capital and a fit-and-proper assessment of directors and senior
        management, not just an AML-only registration. The SC's list also separately shows
        historical operators no longer permitted to continue — only the currently registered list
        is shown here.</p>
      </>
    ) : isKR ? (
      <>
        <h1>Which crypto exchanges are registered in South Korea?</h1>
        <p class="lede">{rows.length} exchanges in our register have a Korean entity registered
        with the Financial Intelligence Unit (FIU) under the Act on Reporting and Using Specified
        Financial Transaction Information. As with Canada's FINTRAC and the US's FinCEN, this is
        <em> not</em> a licence: registration means the FIU supervises the firm for
        anti-money-laundering purposes, not that it has assessed or approved the firm's products or
        conduct. South Korea does not yet have a dedicated cryptoasset business licensing regime.</p>
      </>
    ) : isNZ ? (
      <>
        <h1>Which crypto exchanges are registered in New Zealand?</h1>
        <p class="lede">{rows.length} exchanges in our register have an entity on New Zealand's
        Financial Service Providers Register (FSPR), supervised by the Department of Internal
        Affairs (DIA) under the AML/CFT Act 2009. As with Canada's FINTRAC, the US's FinCEN, and
        South Korea's FIU, this is <em>not</em> a licence: New Zealand has no dedicated cryptoasset
        business licensing regime, and registration means the DIA supervises the firm for
        anti-money-laundering purposes only.</p>
        <p class="lede caveat">Unlike most jurisdictions on this site, this one is not
        automatically synced. The FSPR's public search tool has no fetchable API or bulk export
        available to us, so this list is refreshed only when someone manually re-checks the live
        register — same discipline as Gibraltar and ADGM, but for an AML-only tier rather than a
        genuine licence.</p>
      </>
    ) : (
      <>
        <h1>Which crypto exchanges are licensed in {name}?</h1>
        <p class="lede">{rows.length} exchanges in our register hold an authorisation covering {name},
        per the official ESMA MiCA register. Licensed means the regulator says so — not us.</p>
      </>
    )}

    <div class="table-controls">
      <label>Sort by
        <select id="sort-select">
          <option value="brand">Brand (A–Z)</option>
          <option value="since-desc">Newest first</option>
          <option value="since-asc">Oldest first</option>
          <option value="jurisdictions-desc">Most jurisdictions first</option>
          {!isNonEEA && <option value="services-desc">Most services first</option>}
        </select>
      </label>
      {tiersOnPage.length > 1 && (
        <div class="tier-filter">
          Show:
          {tiersOnPage.map((t) => (
            <label><input type="checkbox" class="tier-checkbox" value={t} checked /> {STATUS_STAMP[t]?.label ?? t}</label>
          ))}
        </div>
      )}
    </div>

    <div class="table-scroll">
    <table class="registry">
      <thead><tr>
        <th>Exchange</th><th>Status</th>
        {isNonEEA ? <th>Entity</th> : <th class="col-services">Services</th>}
        <th>Since</th>
      </tr></thead>
      <tbody>
        {isNonEEA ? rows.map(({ ex, c }) => {
          const since = c.map((e) => e.since).filter(Boolean).sort()[0] ?? '';
          const tiers = [...new Set(c.map((e) => e.status))].join(' ');
          return (
            <tr data-since={since} data-jurisdictions={jurisdictionCount(ex)} data-tiers={tiers}>
              <td class="brand"><a href={`/exchange/${ex.id}/`}>{ex.brand}</a></td>
              <td>
                {c.map((entry) => (
                  <div class="gb-tier">
                    <span class={`stamp ${STATUS_STAMP[entry.status]?.cls ?? 'neutral'}`}>
                      {STATUS_STAMP[entry.status]?.label ?? entry.status} · {entry.regime}
                    </span>
                  </div>
                ))}
              </td>
              <td class="datum">{c.map((entry) => <div>{entry.entity}</div>)}</td>
              <td class="datum">{c.map((entry) => <div>{entry.since ?? '—'}</div>)}</td>
            </tr>
          );
        }) : rows.map(({ ex, c }) => {
          // Union of services and earliest authorisation date across ALL active
          // records whose reach (home state or passport list) covers this country.
          const covering = ex.entities.flatMap((ent) =>
            ent.records
              .filter((r) => r.status === 'authorised' &&
                (ent.home_state === code || r.passported_to.includes(code)))
          );
          const services = [...new Set(covering.flatMap((r) => r.services))].sort();
          const sinceRaw = covering.map((r) => r.authorised).filter(Boolean).sort()[0] ?? '';
          return (
            <tr data-since={sinceRaw} data-jurisdictions={jurisdictionCount(ex)} data-services={services.length}>
              <td class="brand">
                <a href={`/exchange/${ex.id}/`}>{ex.brand}</a>
                <div class="meta">{c.entity}</div>
              </td>
              <td>
                <span class="stamp licensed">Licensed · {c.regime}</span>
                <div class="meta">{c.via === 'home_state' ? 'home state authorisation' : 'EEA passporting'}</div>
              </td>
              <td class="col-services datum">{services.map((s) => SERVICE_NAMES[s]).join(' · ')}</td>
              <td class="datum">{sinceRaw || '—'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>

    {isGB ? (
      <p class="sourced">Source: <a href="https://register.fca.org.uk/">UK FCA Register</a>,
      retrieved {fcaRetrieved}. An exchange missing from this list either holds no UK FCA
      registration or authorisation, or is not yet in our register.</p>
    ) : isCA ? (
      <p class="sourced">Source: <a href="https://fintrac-canafe.canada.ca/msb-esm/reg-eng">FINTRAC MSB Registry</a>,
      retrieved {fintracRetrieved}. An exchange missing from this list either holds no Canadian
      MSB registration for virtual currency services, or is not yet in our register.</p>
    ) : isAE ? (
      <p class="sourced">Sources: <a href="https://www.vara.ae/en/licenses-and-register/public-register/">Dubai VARA Public Register</a>,
      retrieved {varaRetrieved}, and <a href="https://www.adgm.com/public-registers">ADGM FSRA
      Public Register</a>, manually verified {adgmRetrieved}. Covers Dubai and Abu Dhabi Global
      Market only. An exchange missing from this list either holds neither status we could
      independently verify, or is not yet in our register.</p>
    ) : isSG ? (
      <p class="sourced">Source: <a href="https://eservices.mas.gov.sg/fid/institution">MAS Financial Institutions Directory</a>,
      retrieved {masRetrieved}. An exchange missing from this list either holds no MAS DPT licence,
      or is not yet in our register.</p>
    ) : isUS ? (
      <p class="sourced">Sources: <a href="https://msb.fincen.gov/">FinCEN MSB Registrant Search</a>,
      retrieved {fincenRetrieved}, and <a href="https://www.dfs.ny.gov/virtual_currency_businesses">NY
      DFS List of Licensed Virtual Currency Entities</a>, retrieved {nyDfsRetrieved}. An exchange
      missing from this list either holds neither status we could independently verify, or is not
      yet in our register.</p>
    ) : isHK ? (
      <p class="sourced">Source: <a href="https://www.sfc.hk/en/Welcome-to-the-Fintech-Contact-Point/Virtual-assets/Virtual-asset-trading-platforms-operators/Lists-of-virtual-asset-trading-platforms">Hong Kong SFC VATP List</a>,
      retrieved {sfcRetrieved}. An exchange missing from this list either holds no Hong Kong VATP
      licence, or is not yet in our register.</p>
    ) : isGI ? (
      <p class="sourced">Source: <a href="https://www.fsc.gi/regulated-entities/dlt-providers-38">Gibraltar GFSC DLT Providers List</a>,
      last manually verified {gfscRetrieved} — not on an automated schedule. An exchange missing
      from this list either holds no Gibraltar DLT licence, isn't yet in our register, or was added
      after this list was last checked.</p>
    ) : isJP ? (
      <p class="sourced">Source: <a href="https://www.fsa.go.jp/en/regulated/licensed/index.html">Japan FSA Registered Crypto-asset Exchange Service Providers List</a>,
      retrieved {jpFsaRetrieved}. An exchange missing from this list either holds no Japan FSA
      registration, or is not yet in our register.</p>
    ) : isMY ? (
      <p class="sourced">Source: <a href="https://www.sc.com.my/regulation/guidelines/recognizedmarkets/list-of-registered-digital-asset-exchanges">Malaysia SC List of Registered Digital Asset Exchanges</a>,
      retrieved {myScRetrieved}. An exchange missing from this list either holds no Malaysia SC
      RMO-DAX registration, or is not yet in our register.</p>
    ) : isKR ? (
      <p class="sourced">Source: <a href="https://www.kofiu.go.kr/kor/notification/notice.do">Korea FIU VASP Registration Disclosure</a>,
      retrieved {krFiuRetrieved}. An exchange missing from this list either holds no Korea FIU VASP
      registration, or is not yet in our register.</p>
    ) : isNZ ? (
      <p class="sourced">Source: <a href="https://fsp-app.companiesoffice.govt.nz/orp-master/service/create.html?targetAppCode=orp-master&service=registerItemSearch">New Zealand Financial Service Providers Register</a>,
      last manually verified {nzFsprRetrieved} — not on an automated schedule. An exchange missing
      from this list either holds no New Zealand FSPR registration, isn't yet in our register, or
      was added after this list was last checked.</p>
    ) : (
      <p class="sourced">Source: <a href="https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/markets-crypto-assets-regulation-mica">ESMA interim MiCA register</a>,
      retrieved {exchanges[0]?.sources?.[0]?.retrieved}. An exchange missing from this list either
      holds no authorisation covering {name} or is not yet in our register.</p>
    )}
  </main>

