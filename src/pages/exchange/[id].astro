---
import { loadExchanges, COUNTRY_NAMES, SERVICE_NAMES, countryFlag } from '../../lib/data.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return loadExchanges().map((ex) => ({ params: { id: ex.id }, props: { ex } }));
}
const { ex } = Astro.props;
const countryCodes = Object.keys(ex.countries ?? {})
  .sort((a, b) => (COUNTRY_NAMES[a] ?? a).localeCompare(COUNTRY_NAMES[b] ?? b));
// Non-EEA jurisdictions (list-shaped countries.<CC>, unlike the single-object
// EEA/MiCA shape) get a "<prefix> · Registered/Authorised/Licensed" stamp each.
const NON_EEA_PREFIX = { GB: 'UK', CA: 'CA', AE: 'Dubai', SG: 'SG' };
const nonEEAEntries = Object.entries(NON_EEA_PREFIX)
  .flatMap(([cc, prefix]) => (ex.countries?.[cc] ?? []).map((entry) => ({ ...entry, prefix })));
// registered/authorised (UK, CA) are AML-only tiers; licensed (AE/Dubai VARA)
// is a genuine crypto-specific licence, so it gets the same green stamp as
// EU MiCA rather than the cautious amber/grey UK-style tiers.
const STATUS_STAMP = {
  registered: { cls: 'gb-registered', label: 'Registered' },
  authorised: { cls: 'gb-authorised', label: 'Authorised' },
  licensed: { cls: 'licensed', label: 'Licensed' },
};
// Turnstile site keys are public by design (embedded in client HTML), so hardcoding
// this as a fallback is safe. The env var still wins if the build environment sets it.
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`Is ${ex.brand} licensed? Registry record | whichcryptoexchange.com`}</title>
  <meta name="description" content={`${ex.brand}: official licence records, legal entities, regulators, and the ${countryCodes.length} countries its authorisation covers.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="logo" href="/">which<em>crypto</em>exchange</a>
    <span class="sourced">source: official regulator registers</span>
  </div></header>

  <main class="wrap">
    <h1>{ex.brand}</h1>
    <p class="lede">
      {ex.eu_status === 'authorised' && <span class="stamp licensed">EU · MiCA Authorised</span>}
      {ex.eu_status === 'withdrawn' && <span class="stamp withdrawn">EU · Authorisation Withdrawn</span>}
      {/* no_eu_entity: this brand has never had an EU entity — omit the EU
          stamp entirely rather than showing a misleading withdrawn/licensed
          state either way. */}
      {nonEEAEntries.map((entry) => (
        <span class={`stamp ${STATUS_STAMP[entry.status]?.cls ?? 'neutral'}`}>
          {entry.prefix} · {STATUS_STAMP[entry.status]?.label ?? entry.status}
        </span>
      ))}
    </p>

    {ex.entities.map((ent) => ent.records.map((rec) => (
      <div class={`record ${rec.status}`}>
        <h3>{ent.legal_name}</h3>
        <dl>
          <dt>Regulator</dt><dd>{ent.regulator}</dd>
          <dt>Home state</dt><dd class="datum">{ent.home_state} — {COUNTRY_NAMES[ent.home_state] ?? ''}</dd>
          {ent.lei && <><dt>LEI</dt><dd class="datum">{ent.lei}</dd></>}
          <dt>Authorised</dt><dd class="datum">{rec.authorised ?? '—'}</dd>
          {rec.withdrawn && <><dt>Withdrawn</dt><dd class="datum">{rec.withdrawn}</dd></>}
          <dt>Services</dt><dd>{rec.services.map((s) => SERVICE_NAMES[s]).join(' · ')}</dd>
          <dt>Passported to</dt><dd class="datum">{rec.passported_to.join(' · ') || '—'}</dd>
        </dl>
      </div>
    )))}

    <h3>Countries covered ({countryCodes.length})</h3>
    <ul class="country-grid">
      {countryCodes.map((c) => (
        <li><a href={`/${c.toLowerCase()}/`}><span class="cc flag">{countryFlag(c)}</span>{COUNTRY_NAMES[c] ?? c}</a></li>
      ))}
    </ul>

    <section class="reports" id="reports">
      <h3>User reports</h3>
      <p class="sourced">Community-sourced and reviewed before publication. Kept strictly separate
      from the regulator-sourced data above.</p>
      <div id="report-aggregates" data-exchange={ex.id}><p class="sourced">Loading reports…</p></div>

      {SITEKEY ? (
        <details class="report-form">
          <summary>Do you use {ex.brand} from your country? Report your experience</summary>
          <form id="report-form">
            <input type="hidden" name="exchange_id" value={ex.id} />
            <label>Your country
              <select name="country" required>
                <option value="">Select…</option>
                {Object.entries(COUNTRY_NAMES).map(([cc, n]) => <option value={cc}>{n}</option>)}
                <option value="GB">United Kingdom</option>
                <option value="US">United States</option>
                <option value="AU">Australia</option>
                <option value="NZ">New Zealand</option>
                <option value="CA">Canada</option>
              </select>
            </label>
            <label>What happened?
              <select name="outcome" required>
                <option value="">Select…</option>
                <option value="signup_ok">Signed up successfully</option>
                <option value="signup_blocked">Blocked at signup</option>
                <option value="kyc_blocked">Blocked at KYC</option>
                <option value="withdrawal_ok">Withdrawal succeeded</option>
                <option value="withdrawal_delayed">Withdrawal delayed</option>
                <option value="withdrawal_refused">Withdrawal refused</option>
                <option value="account_closed">Account closed by exchange</option>
                <option value="geo_blocked">Geo-blocked</option>
              </select>
            </label>
            <label>When (optional) <input type="date" name="occurred_on" /></label>
            <label>Details (optional) <textarea name="detail" maxlength="1000" rows="3"></textarea></label>
            <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
            <button type="submit">Submit report</button>
            <p class="form-msg sourced" role="status"></p>
          </form>
        </details>
      ) : (
        <p class="sourced">Report submissions are opening soon.</p>
      )}
    </section>

    <p class="sourced">Source: {ex.sources[0].name}, retrieved {ex.sources[0].retrieved} —
    <a href={ex.sources[0].url}>original file</a>.</p>
  </main>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    // Aggregates: fetched client-side because pages are static.
    const box = document.getElementById('report-aggregates');
    fetch('/api/reports/' + box.dataset.exchange)
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((d) => {
        if (!d.total) { box.innerHTML = '<p class="sourced">No published reports yet — be the first.</p>'; return; }
        const byCountry = {};
        for (const row of d.rows) (byCountry[row.country] ??= []).push(row);
        box.innerHTML = Object.entries(byCountry).map(([cc, rows]) =>
          `<p><span class="datum">${cc}</span> — ` +
          rows.map((r) => `${d.labels[r.outcome] ?? r.outcome}: ${r.n}`).join(' · ') + '</p>'
        ).join('') + `<p class="sourced">${d.total} published report${d.total === 1 ? '' : 's'} in total.</p>`;
      })
      .catch(() => { box.innerHTML = '<p class="sourced">Reports unavailable right now.</p>'; });

    // Submission
    const form = document.getElementById('report-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('.form-msg');
      const fd = new FormData(form);
      const token = form.querySelector('[name="cf-turnstile-response"]')?.value;
      msg.textContent = 'Submitting…';
      try {
        const res = await fetch('/api/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            exchange_id: fd.get('exchange_id'), country: fd.get('country'),
            outcome: fd.get('outcome'), occurred_on: fd.get('occurred_on'),
            detail: fd.get('detail'), turnstile_token: token,
          }),
        });
        const data = await res.json();
        msg.textContent = data.message ?? data.error ?? 'Something went wrong.';
        if (res.ok) form.reset();
      } catch { msg.textContent = 'Network error — please try again.'; }
    });
  </script>

  <footer class="site"><div class="wrap">
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>
</body>
</html>
