---
import { loadExchanges, COUNTRY_NAMES, SERVICE_NAMES, countryFlag, brandWebsite, NON_EEA_PREFIX, licenceFacts, licenceSummaryText, listJoin, countryStatusMap, footerStats } from '../../lib/data.js';
import '../../styles/global.css';

export function getStaticPaths() {
  const exchanges = loadExchanges();
  const stats = footerStats(exchanges);
  return exchanges.map((ex) => ({ params: { id: ex.id }, props: { ex, stats } }));
}
const { ex, stats } = Astro.props;
const website = brandWebsite(ex);
const {
  countryCodes, nonEEAEntries, genuineLicenceJurisdictions, amlOnlyJurisdictions,
  hasSeparateUKAuthorisation, firstSeen, totalEntities,
} = licenceFacts(ex);
// A brand can have more than one legal entity with the same status in the
// same jurisdiction (e.g. a separate broker entity and custody entity, both
// FCA-registered) — collapse those into one badge with a count rather than
// rendering visually-identical stamps with nothing to tell them apart.
// Full per-entity detail (entity names) still lives on the country pages.
const nonEEAGrouped = Object.values(
  nonEEAEntries.reduce((acc, e) => {
    const key = `${e.prefix}|${e.status}`;
    (acc[key] ??= { prefix: e.prefix, status: e.status, count: 0 }).count++;
    return acc;
  }, {})
);
// registered/authorised (UK, CA) are AML-only tiers; licensed (AE/Dubai VARA)
// is a genuine crypto-specific licence, so it gets the same green stamp as
// EU MiCA rather than the cautious amber/grey UK-style tiers.
const STATUS_STAMP = {
  registered: { cls: 'gb-registered', label: 'Registered' },
  authorised: { cls: 'gb-authorised', label: 'Authorised' },
  licensed: { cls: 'licensed', label: 'Licensed' },
};
// Turnstile site keys are public by design (embedded in client HTML), so hardcoding
// this as a fallback is safe. The env var still wins if the build environment sets it.
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';

// FAQPage schema for the one question this page actually answers in
// detail -- the same text as the visible summary-box paragraph below, via
// licenceSummaryText, so the structured data can never say something the
// page itself doesn't.
const faqAnswer = licenceSummaryText(ex);

// Per-country facts for the "check your country" widget -- computed at
// build time, embedded as JSON, read client-side rather than fetched, so
// the licence-status half of the widget works instantly with no request.
const countryFacts = countryStatusMap(ex);

// schema.org Certification -- built for exactly this: "an authoritative
// body issued this organization a credential." One per verified record,
// EEA and non-EEA alike, so every stamp on the page has a machine-
// readable counterpart carrying the same regulator/entity/date facts.
const certifications = [
  ...ex.entities.flatMap((ent) => ent.records.map((rec) => ({
    '@type': 'Certification',
    name: 'MiCA Authorisation',
    certificationStatus: rec.status === 'withdrawn' ? 'CertificationInactive' : 'CertificationActive',
    issuedBy: { '@type': 'Organization', name: ent.regulator },
    about: { '@type': 'Organization', name: ent.legal_name },
    ...(rec.authorised && { validFrom: rec.authorised }),
    ...(rec.withdrawn && { validThrough: rec.withdrawn }),
  }))),
  ...nonEEAEntries.map((entry) => ({
    '@type': 'Certification',
    name: entry.regime,
    certificationStatus: 'CertificationActive',
    about: { '@type': 'Organization', name: entry.entity },
    ...(entry.since && { validFrom: entry.since }),
  })),
];
const PAGE_TITLE = `Is ${ex.brand} licensed? Registry record | whichcryptoexchange.com`;
const PAGE_DESC = `${ex.brand}: official licence records, legal entities, regulators, and the ${countryCodes.length} countries its authorisation covers.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'whichcryptoexchange.com', item: 'https://whichcryptoexchange.com/' },
      { '@type': 'ListItem', position: 2, name: ex.brand, item: `https://whichcryptoexchange.com/exchange/${ex.id}/` },
    ],
  })} />
  {certifications.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: ex.brand,
      url: `https://whichcryptoexchange.com/exchange/${ex.id}/`,
      hasCredential: certifications,
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{
      '@type': 'Question',
      name: `Is ${ex.brand} licensed?`,
      acceptedAnswer: { '@type': 'Answer', text: faqAnswer },
    }],
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>{ex.brand}</h1>
    <p class="lede">
      {ex.eu_status === 'authorised' && <span class="stamp licensed">EU · MiCA Authorised</span>}
      {ex.eu_status === 'withdrawn' && <span class="stamp withdrawn">EU · Authorisation Withdrawn</span>}
      {/* no_eu_entity: this brand has never had an EU entity — omit the EU
          stamp entirely rather than showing a misleading withdrawn/licensed
          state either way. */}
      {nonEEAGrouped.map((entry) => (
        <span class={`stamp ${STATUS_STAMP[entry.status]?.cls ?? 'neutral'}`}>
          {entry.prefix} · {STATUS_STAMP[entry.status]?.label ?? entry.status}{entry.count > 1 ? ` (${entry.count} entities)` : ''}
        </span>
      ))}
      {website && <> · <a href={website} rel="nofollow noopener" target="_blank">Visit {ex.brand} ↗</a></>}
    </p>

    <p class="summary-box">
      {firstSeen
        ? <>{ex.brand} first appears in our register on <strong class="datum">{firstSeen}</strong>, </>
        : <>{ex.brand} appears in our register </>}
      and is currently tracked across <strong>{countryCodes.length}</strong> jurisdiction{countryCodes.length === 1 ? '' : 's'}
      through <strong>{totalEntities}</strong> legal entit{totalEntities === 1 ? 'y' : 'ies'}.
      {genuineLicenceJurisdictions.length > 0 && (
        <> It holds a genuine crypto-specific licence in {listJoin(genuineLicenceJurisdictions)}.</>
      )}
      {amlOnlyJurisdictions.length > 0 && (
        <> It also holds an AML-only registration (not a licence) in {listJoin(amlOnlyJurisdictions)}.</>
      )}
      {hasSeparateUKAuthorisation && (
        <> A group entity is separately, fully FCA-authorised in the UK, usually for a different, non-crypto activity.</>
      )}
      {ex.eu_status === 'withdrawn' && (
        <> Its EU MiCA authorisation has since been withdrawn.</>
      )}
      {genuineLicenceJurisdictions.length === 0 && amlOnlyJurisdictions.length === 0 && ex.eu_status !== 'authorised' && ex.eu_status !== 'withdrawn' && (
        <> We have not independently verified a genuine crypto-specific licence or registration for {ex.brand} in any jurisdiction we track.</>
      )}
    </p>

    <div class="country-check" id="country-check">
      <h3>Check your country</h3>
      <label for="country-check-select">See {ex.brand}'s regulatory status and user reports for your country</label>
      <select id="country-check-select">
        <option value="">Select your country…</option>
        {Object.entries(COUNTRY_NAMES).map(([cc, n]) => <option value={cc}>{n}</option>)}
        <option value="AU">Australia</option>
        <option value="NZ">New Zealand</option>
      </select>
      <div id="country-check-result" class="country-check-result" hidden></div>
      <script type="application/json" id="country-facts-data" set:html={JSON.stringify(countryFacts)} />
    </div>

    <div id="affiliate-cta" data-exchange={ex.id} data-brand={ex.brand}></div>

    {SITEKEY && (
      <details class="report-form">
        <summary>Get an email if {ex.brand}'s status changes</summary>
        <form id="watch-form">
          <input type="hidden" name="exchange_id" value={ex.id} />
          <label>Your email
            <input type="email" name="email" required maxlength="200" />
          </label>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want an email if {ex.brand}'s regulatory status changes. See
            <a href="/about/">how this works</a> — unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <button type="submit">Watch {ex.brand}</button>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </details>
    )}

    {ex.entities.map((ent) => ent.records.map((rec) => (
      <div class={`record ${rec.status}`}>
        <h3>{ent.legal_name}</h3>
        <dl>
          <dt>Regulator</dt><dd>{ent.regulator}</dd>
          <dt>Home state</dt><dd class="datum">{ent.home_state} — {COUNTRY_NAMES[ent.home_state] ?? ''}</dd>
          {ent.lei && <><dt>LEI</dt><dd class="datum">{ent.lei}</dd></>}
          <dt>Authorised</dt><dd class="datum">{rec.authorised ?? '—'}</dd>
          {rec.withdrawn && <><dt>Withdrawn</dt><dd class="datum">{rec.withdrawn}</dd></>}
          <dt>Services</dt><dd>{rec.services.map((s) => SERVICE_NAMES[s]).join(' · ')}</dd>
          <dt>Passported to</dt><dd class="datum">{rec.passported_to.join(' · ') || '—'}</dd>
        </dl>
      </div>
    )))}

    {/* Non-EEA entity detail -- same level of detail as the EEA record
        cards above, kept in a separate CSS class (non-eea-<status>) since
        "authorised" means something different here (GB's separate,
        non-crypto FCA authorisation) than it does for an EEA MiCA record,
        and must not inherit that tier's green border. */}
    {nonEEAEntries.map((entry) => (
      <div class={`record non-eea-${entry.status}`}>
        <h3>{entry.entity}</h3>
        <dl>
          <dt>Jurisdiction</dt><dd class="datum">{entry.prefix}</dd>
          <dt>Regime</dt><dd>{entry.regime}</dd>
          <dt>Status</dt><dd class="datum">{STATUS_STAMP[entry.status]?.label ?? entry.status}</dd>
          {(entry.reg_number ?? entry.reference ?? entry.frn) && (
            <><dt>Reference</dt><dd class="datum">{entry.reg_number ?? entry.reference ?? entry.frn}</dd></>
          )}
          <dt>Since</dt><dd class="datum">{entry.since ?? '—'}</dd>
          {entry.expires && <><dt>Expires</dt><dd class="datum">{entry.expires}</dd></>}
          {entry.licensed_activities && <><dt>Activities</dt><dd>{entry.licensed_activities}</dd></>}
        </dl>
        {entry.caveat && <p class="caveat">{entry.caveat}</p>}
      </div>
    ))}

    <h3>Countries covered ({countryCodes.length})</h3>
    <ul class="country-grid">
      {countryCodes.map((c) => (
        <li><a href={`/${c.toLowerCase()}/`}><span class="cc flag">{countryFlag(c)}</span>{COUNTRY_NAMES[c] ?? c}</a></li>
      ))}
    </ul>

    <section class="reports" id="reports">
      <h3>User reports</h3>
      <p class="sourced">Community-sourced and reviewed before publication. Kept strictly separate
      from the regulator-sourced data above.</p>
      <div id="report-aggregates" data-exchange={ex.id}><p class="sourced">Loading reports…</p></div>

      {SITEKEY ? (
        <details class="report-form" open>
          <summary>Do you use {ex.brand} from your country? Report your experience</summary>
          <form id="report-form">
            <input type="hidden" name="exchange_id" value={ex.id} />
            <label>Your country
              <select name="country" required>
                <option value="">Select…</option>
                {Object.entries(COUNTRY_NAMES).map(([cc, n]) => <option value={cc}>{n}</option>)}
                <option value="AU">Australia</option>
                <option value="NZ">New Zealand</option>
              </select>
            </label>
            <label>What happened?
              <select name="outcome" required>
                <option value="">Select…</option>
                <option value="signup_ok">Signed up successfully</option>
                <option value="signup_blocked">Blocked at signup</option>
                <option value="kyc_blocked">Blocked at KYC</option>
                <option value="withdrawal_ok">Withdrawal succeeded</option>
                <option value="withdrawal_delayed">Withdrawal delayed</option>
                <option value="withdrawal_refused">Withdrawal refused</option>
                <option value="account_closed">Account closed by exchange</option>
                <option value="geo_blocked">Geo-blocked</option>
              </select>
            </label>
            <label>When (optional) <input type="date" name="occurred_on" /></label>
            <label>Details (optional) <textarea name="detail" maxlength="1000" rows="3"></textarea></label>
            <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
            <button type="submit">Submit report</button>
            <p class="form-msg sourced" role="status"></p>
          </form>
        </details>
      ) : (
        <p class="sourced">Report submissions are opening soon.</p>
      )}
    </section>

    <section class="third-party-reviews" id="third-party-reviews">
      <h3>What others report</h3>
      <p class="sourced">Third-party ratings, not verified by us — each figure links to its
      original source. Kept separate from the regulator-sourced facts above and the
      first-party user reports above.</p>
      {(ex.third_party_reviews ?? []).length > 0 ? (
        <ul class="review-sources">
          {(ex.third_party_reviews ?? []).map((r) => (
            <li class="review-source">
              <span class="review-source-name">{r.source}</span>
              <span class="review-source-rating">{r.rating}<span class="review-source-max">/5</span></span>
              <span class="review-source-count">{r.count.toLocaleString()} reviews</span>
              <a href={r.url} rel="nofollow noopener" target="_blank">View on {r.source} ↗</a>
              <span class="sourced review-source-date">Retrieved {r.retrieved}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="sourced">No third-party rating data collected yet for {ex.brand}.</p>
      )}
    </section>

    <p class="sourced">Sources:{' '}
    {(ex.sources ?? []).map((s, i) => (
      <>
        {i > 0 && ' · '}
        {s.name}, retrieved {s.retrieved} — <a href={s.url}>original file</a>
      </>
    ))}.</p>
  </main>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    // Affiliate link: fetched client-side and rendered only if one is set
    // for this brand — commercial data, deliberately not baked into the
    // static build (see /admin/links). Built with DOM APIs, not innerHTML,
    // since the URL/label ultimately come from a database value.
    (() => {
      const box = document.getElementById('affiliate-cta');
      fetch('/api/links/' + box.dataset.exchange)
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((d) => {
          const a = document.createElement('a');
          a.className = 'cta-button';
          a.href = d.url;
          a.target = '_blank';
          a.rel = 'nofollow sponsored noopener';
          a.textContent = d.label || `Visit ${box.dataset.brand} ↗`;
          const note = document.createElement('p');
          note.className = 'sourced cta-disclosure';
          note.textContent = 'Affiliate link — we may earn a commission at no extra cost to you.';
          box.append(a, note);
        })
        .catch(() => {});
    })();

    // Check-your-country widget: licence status comes from the JSON blob
    // embedded above (no request); user-report counts reuse the same
    // aggregates fetch below rather than firing a second request.
    let reportsData = null;
    let reportsFailed = false;
    const countryFacts = JSON.parse(document.getElementById('country-facts-data').textContent);
    const ccSelect = document.getElementById('country-check-select');
    const ccResult = document.getElementById('country-check-result');
    function renderCountryCheck() {
      const cc = ccSelect.value;
      if (!cc) { ccResult.hidden = true; return; }
      const countryLabel = ccSelect.selectedOptions[0].text;
      const fact = countryFacts[cc];
      let html = fact
        ? `<p><strong>${countryLabel}:</strong> ${fact.text}${fact.regimes.length ? ` — ${fact.regimes.join(', ')}` : ''}.</p>`
        : `<p><strong>${countryLabel}:</strong> not covered — no verified licence or registration on file here.</p>`;
      if (reportsFailed) {
        html += '<p class="sourced">User reports unavailable right now.</p>';
      } else if (reportsData) {
        const rows = reportsData.rows.filter((r) => r.country === cc);
        html += rows.length
          ? `<p class="sourced">User reports from ${countryLabel}: ` +
            rows.map((r) => `${reportsData.labels[r.outcome] ?? r.outcome}: ${r.n}`).join(' · ') + '</p>'
          : `<p class="sourced">No user reports yet from ${countryLabel}.</p>`;
      } else {
        html += '<p class="sourced">Loading user reports…</p>';
      }
      ccResult.className = `country-check-result ${fact ? fact.level : 'none'}`;
      ccResult.innerHTML = html;
      ccResult.hidden = false;
    }
    ccSelect?.addEventListener('change', renderCountryCheck);

    // Aggregates: fetched client-side because pages are static.
    const box = document.getElementById('report-aggregates');
    fetch('/api/reports/' + box.dataset.exchange)
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((d) => {
        reportsData = d;
        if (ccSelect.value) renderCountryCheck();
        if (!d.total) { box.innerHTML = '<p class="sourced">No published reports yet — be the first.</p>'; return; }
        const byCountry = {};
        for (const row of d.rows) (byCountry[row.country] ??= []).push(row);
        box.innerHTML = Object.entries(byCountry).map(([cc, rows]) =>
          `<p><span class="datum">${cc}</span> — ` +
          rows.map((r) => `${d.labels[r.outcome] ?? r.outcome}: ${r.n}`).join(' · ') + '</p>'
        ).join('') + `<p class="sourced">${d.total} published report${d.total === 1 ? '' : 's'} in total.</p>`;
      })
      .catch(() => {
        reportsFailed = true;
        if (ccSelect.value) renderCountryCheck();
        box.innerHTML = '<p class="sourced">Reports unavailable right now.</p>';
      });

    // Watch-this-exchange signup
    const watchForm = document.getElementById('watch-form');
    watchForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = watchForm.querySelector('.form-msg');
      const fd = new FormData(watchForm);
      const token = watchForm.querySelector('[name="cf-turnstile-response"]')?.value;
      msg.textContent = 'Submitting…';
      try {
        const res = await fetch('/api/watch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            exchange_id: fd.get('exchange_id'), email: fd.get('email'),
            consent: fd.get('consent') === 'on', turnstile_token: token,
          }),
        });
        const data = await res.json();
        msg.textContent = data.message ?? data.error ?? 'Something went wrong.';
        if (res.ok) watchForm.reset();
      } catch { msg.textContent = 'Network error — please try again.'; }
    });

    // Submission
    const form = document.getElementById('report-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('.form-msg');
      const fd = new FormData(form);
      const token = form.querySelector('[name="cf-turnstile-response"]')?.value;
      msg.textContent = 'Submitting…';
      try {
        const res = await fetch('/api/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            exchange_id: fd.get('exchange_id'), country: fd.get('country'),
            outcome: fd.get('outcome'), occurred_on: fd.get('occurred_on'),
            detail: fd.get('detail'), turnstile_token: token,
          }),
        });
        const data = await res.json();
        msg.textContent = data.message ?? data.error ?? 'Something went wrong.';
        if (res.ok) form.reset();
      } catch { msg.textContent = 'Network error — please try again.'; }
    });
  </script>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/reviews/">Reviews</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
    <p class="footer-meta">{stats.brandCount} brands tracked across {stats.jurisdictionCount} jurisdictions · Data last synced {stats.lastSynced} · <a href="/changelog.xml">RSS</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script src="/search.js" defer></script>
</body>
</html>
