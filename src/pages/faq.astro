---
import { loadExchanges, loadRegulatorDetails } from '../lib/data.js';
import { buildFaqEntries } from '../lib/faq.js';
import '../styles/global.css';

const exchanges = loadExchanges();
const regulatorDetails = loadRegulatorDetails();
const entries = buildFaqEntries(exchanges, regulatorDetails);
const generalEntries = entries.filter((e) => e.category === 'general');
const PAGE_TITLE = 'Crypto Exchange FAQ: Licensing, Regulation & Custody | whichcryptoexchange.com';
const PAGE_DESC = `Search ${entries.length} questions and answers about crypto exchange licensing, built entirely from our own regulator-sourced register -- by brand, by country, or in general.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: generalEntries.map((e) => ({
      '@type': 'Question',
      name: e.question,
      acceptedAnswer: { '@type': 'Answer', text: e.answer },
    })),
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>Frequently Asked Questions</h1>
    <p class="lede">{entries.length} questions and answers, generated entirely from the register
    itself — the same verified facts shown on every brand and country page, just phrased as the
    questions people actually search. Search by brand or country name, or browse the general
    questions below.</p>

    <div class="faq-search-box">
      <input type="search" id="faq-search" placeholder="Search questions — try a brand or country name…" autocomplete="off" aria-label="Search FAQ" />
      <div class="faq-chips" role="group" aria-label="Filter by category">
        <button type="button" class="faq-chip active" data-category="all">All</button>
        <button type="button" class="faq-chip" data-category="general">General</button>
        <button type="button" class="faq-chip" data-category="country">By country</button>
        <button type="button" class="faq-chip" data-category="brand">By brand</button>
      </div>
    </div>

    <div id="faq-results"></div>
    <p class="sourced">Can't find what you're after? <a href="/contact/">Get in touch</a> — or if
    you're an official regulator source we should be checking against, <a href="/about/">see how
    the register works</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script src="/search.js" defer></script>
  <script src="/faq.js" defer></script>
</body>
</html>
