---
import { loadProviders, loadExchanges } from '../../lib/data.js';
import '../../styles/global.css';

const exchanges = loadExchanges();
const providers = loadProviders().map((p) => ({
  ...p,
  partners: (p.partners ?? []).map((partner) => ({
    ...partner,
    ex: exchanges.find((ex) => ex.id === partner.brand_id),
  })),
  factsVerified: (p.partners ?? []).length > 0 && (p.partners ?? []).every((partner) => partner.verified),
}));
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const PAGE_TITLE = 'Technology Providers Using Licensed Custodians | whichcryptoexchange.com';
const PAGE_DESC = 'Crypto apps and platforms that are not themselves licensed, but rely on a licensed custodian to actually hold and execute customer assets. Who really holds your crypto?';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: providers.length,
    itemListElement: providers.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `https://whichcryptoexchange.com/providers/${p.id}/`,
    })),
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <div class="editorial-banner">
      <strong>Editorial content, not the register.</strong> These profiles are not licence records —
      see <a href="/about/">how the register itself works</a> for that.
    </div>

    <div class="page-header">
      <div class="page-header-main">
        <h1>Who actually holds your crypto?</h1>
        <p class="lede">Some crypto apps and platforms aren't licensed themselves — they're a
        technology layer on top of a custodian or execution partner who is. That's not necessarily a
        red flag, but it's a fact worth knowing plainly.</p>
      </div>
      <div class="submit-cta">
        <h3>Rely on a licensed partner?</h3>
        <p>Get a Provider Profile. Not automatic — we independently verify the partnership before
        publishing anything.</p>
        <a class="button-link" href="/providers/submit/">Submit your details</a>
      </div>
    </div>

    <h3>Badges explained</h3>
    <p class="sourced">Each profile can carry up to two badges, and they mean two different
    things — neither substitutes for the other:
    <span class="badge badge-verified-facts">✅ Verified Facts</span> means we've checked the
    regulatory claims against a primary source ourselves, and it's free.
    <span class="badge badge-claimed">🏢 Claimed Profile</span> means the company has proven it
    controls this listing, via a confirmed email address and a real backlink from their own site —
    also free, and required before we activate a link to their site.</p>

    {SITEKEY && (
      <div class="digest-cta">
        <h3>Get the weekly regulatory roundup</h3>
        <p>Every status change across every tracked exchange, once a week, straight to your inbox.
        Free, no spam — one email a week, unsubscribe any time.</p>
        <form id="digest-form">
          <div class="digest-cta-row">
            <input type="email" name="email" placeholder="you@example.com" required maxlength="200" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </div>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want the weekly regulatory roundup email. See <a href="/about/">how this works</a> —
            unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </div>
    )}

    <h3>Crypto Technology Providers List</h3>
    <p class="lede">Each profile below names the company, states clearly that it isn't
    independently licensed, and identifies who actually holds and executes customer assets — with
    a link through to each partner's real, verified regulatory status.</p>

    {providers.map((p) => (
      <div class="provider-card">
        <h3><a href={`/providers/${p.id}/`}>{p.name}</a> <span class="badge-unlicensed">Not independently licensed</span></h3>
        <div class="provider-badges">
          {p.factsVerified && <span class="badge badge-verified-facts">✅ Verified Facts</span>}
          {p.claimed?.status && <span class="badge badge-claimed">🏢 Claimed Profile</span>}
        </div>
        <dl>
          {p.partners.map((partner) => (
            <>
              <dt>Partner</dt><dd>{partner.ex ? <a href={`/exchange/${partner.ex.id}/`}>{partner.name}</a> : partner.name} — <span class="datum">{partner.licence}</span></dd>
            </>
          ))}
          <dt>Website</dt>
          <dd>
            {p.claimed?.status
              ? <a href={p.website} rel="nofollow noopener" target="_blank">{p.website} ↗</a>
              : <span class="provider-website-unclaimed">{new URL(p.website).hostname} (unclaimed — link inactive) ·{' '}
                <a href={`/providers/submit/?company=${encodeURIComponent(p.name)}&website=${encodeURIComponent(p.website)}`}>Is this your company? Claim this profile</a></span>}
          </dd>
          <dt>Last verified</dt><dd class="datum">{p.last_verified}</dd>
        </dl>
      </div>
    ))}

    <p class="sourced">Is your company a technology provider relying on a licensed custodian, and
    want a profile here? <a href="/providers/submit/">Submit your details</a> — every fact we
    can't independently verify is clearly tagged as a company disclosure, not a verified claim.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
