---
import { loadProviders, loadExchanges } from '../../lib/data.js';
import '../../styles/global.css';

export function getStaticPaths() {
  const exchanges = loadExchanges();
  return loadProviders().map((p) => ({ params: { id: p.id }, props: { p, exchanges } }));
}
const { p, exchanges } = Astro.props;
const partners = (p.partners ?? []).map((partner) => ({
  ...partner,
  ex: exchanges.find((ex) => ex.id === partner.brand_id),
}));
const factsVerified = partners.length > 0 && partners.every((partner) => partner.verified);
const websiteActive = Boolean(p.claimed?.status || p.enhanced?.status);
const PAGE_TITLE = `${p.name}: technology provider profile | whichcryptoexchange.com`;
const PAGE_DESC = `${p.name} is not itself a licensed exchange. See who actually holds and executes customer assets, and whether those partners are independently verified.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/logo.jpg" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <div class="editorial-banner">
      <strong>Editorial content, not the register.</strong> This is a Technology Provider Profile —
      it explains a company's business model and who actually holds/executes customer assets. It is
      not a licence record. See <a href="/providers/">all provider profiles</a> or
      <a href="/about/">how the register itself works</a>.
    </div>

    <h1>{p.name}</h1>
    <p class="lede">
      <span class="badge-unlicensed">Not independently licensed</span>
      {websiteActive
        ? <> · <a href={p.website} rel="nofollow noopener" target="_blank">Visit {p.name} ↗</a></>
        : <> · <span class="provider-website-unclaimed">{new URL(p.website).hostname} (unclaimed — link inactive)</span></>}
    </p>
    <div class="provider-badges">
      {factsVerified && <span class="badge badge-verified-facts">✅ Verified Facts</span>}
      {p.claimed?.status && <span class="badge badge-claimed">🏢 Claimed Profile</span>}
      {p.enhanced?.status && <span class="badge badge-enhanced">⭐ Enhanced Listing</span>}
    </div>
    <p class="lede">{p.overview}</p>

    {partners.length > 0 && (
      <>
        <h3>Who actually holds and executes customer assets</h3>
        {partners.map((partner) => (
          <div class="provider-card">
            <dl>
              <dt>Partner</dt>
              <dd>{partner.ex ? <a href={`/exchange/${partner.ex.id}/`}>{partner.name}</a> : partner.name}
                {partner.verified && <span class="source-tag verified">Verified</span>}</dd>
              <dt>Role</dt><dd>{partner.role}</dd>
              <dt>Licence</dt><dd class="datum">{partner.licence}</dd>
            </dl>
          </div>
        ))}
      </>
    )}

    <h3>Countries served</h3>
    <ul>
      {p.countries_served.map((c) => (
        <li><strong>{c.label}</strong> — {c.detail}
          {c.verified
            ? <span class="source-tag verified">Verified</span>
            : <span class="source-tag disclosed">Company disclosure</span>}
        </li>
      ))}
    </ul>

    <h3>Sources</h3>
    <ul class="sourced">
      {p.sources.map((s) => (
        <li>{s.url
          ? <a href={s.url} rel={s.verified ? undefined : 'nofollow noopener'}>{s.label}</a>
          : s.label}
          {s.verified
            ? <span class="source-tag verified">Verified</span>
            : <span class="source-tag disclosed">Company disclosure</span>}
        </li>
      ))}
    </ul>
    <p class="sourced">Last verified {p.last_verified}. Something out of date, or are you {p.name}
    and want to correct or add detail? <a href="/contact/">Get in touch</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script src="/search.js" defer></script>
</body>
</html>
