---
import { loadProviders, loadExchanges } from '../../lib/data.js';
import '../../styles/global.css';

export function getStaticPaths() {
  const exchanges = loadExchanges();
  return loadProviders().map((p) => ({ params: { id: p.id }, props: { p, exchanges } }));
}
const { p, exchanges } = Astro.props;
const partners = (p.partners ?? []).map((partner) => ({
  ...partner,
  ex: exchanges.find((ex) => ex.id === partner.brand_id),
}));
const countries = p.countries_served ?? [];
const sources = p.sources ?? [];
const factsVerified = partners.length > 0 && partners.every((partner) => partner.verified);
const websiteActive = Boolean(p.claimed?.status);

// The page splits into two sections by provenance, not by fact type -- a
// custody claim we've checked against a primary source and one we haven't
// can sit right next to each other in the data, so they belong in
// different sections regardless of which of partners/countries/sources
// they came from. See src/pages/providers/index.astro's badge legend for
// what "Verified Facts" means at the page-badge level.
const verifiedPartners = partners.filter((x) => x.verified);
const disclosedPartners = partners.filter((x) => !x.verified);
const verifiedCountries = countries.filter((x) => x.verified);
const disclosedCountries = countries.filter((x) => !x.verified);
const verifiedSources = sources.filter((x) => x.verified);
const disclosedSources = sources.filter((x) => !x.verified);
const hasDisclosed = disclosedPartners.length + disclosedCountries.length + disclosedSources.length > 0;
const PAGE_TITLE = `${p.name}: technology provider profile | whichcryptoexchange.com`;
const PAGE_DESC = `${p.name} is not itself a licensed exchange. See who actually holds and executes customer assets, and whether those partners are independently verified.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/stats/">Stats</a>
    </div></nav>
  </header>

  <main class="wrap">
    <div class="editorial-banner">
      <strong>Editorial content, not the register.</strong> This is a Technology Provider Profile —
      it explains a company's business model and who actually holds/executes customer assets. It is
      not a licence record. See <a href="/providers/">all provider profiles</a> or
      <a href="/about/">how the register itself works</a>.
    </div>

    <h1>{p.name}</h1>
    <p class="lede">
      <span class="badge-unlicensed">Not independently licensed</span>
      {websiteActive
        ? <> · <a href={p.website} rel="nofollow noopener" target="_blank">Visit {p.name} ↗</a></>
        : <> · <span class="provider-website-unclaimed">{new URL(p.website).hostname} (unclaimed — link inactive) ·{' '}
            <a href={`/providers/submit/?company=${encodeURIComponent(p.name)}&website=${encodeURIComponent(p.website)}`}>Is this your company? Claim this profile</a></span></>}
    </p>
    <div class="provider-badges">
      {factsVerified && <span class="badge badge-verified-facts">✅ Verified Facts</span>}
      {p.claimed?.status && <span class="badge badge-claimed">🏢 Claimed Profile</span>}
    </div>
    <p class="lede">{p.overview}</p>

    <div class="record verified-block">
      <h3>✅ Verified by us</h3>
      <p class="sourced">Checked against a primary source ourselves — a regulator register, the
      partner's own official listing, or equivalent.</p>

      {verifiedPartners.length > 0 && (
        <>
          <p class="fact-section-label">Who actually holds and executes customer assets</p>
          {verifiedPartners.map((partner) => (
            <div class="provider-card">
              <dl>
                <dt>Partner</dt>
                <dd>{partner.ex ? <a href={`/exchange/${partner.ex.id}/`}>{partner.name}</a> : partner.name}</dd>
                <dt>Role</dt><dd>{partner.role}</dd>
                <dt>Licence</dt><dd class="datum">{partner.licence}</dd>
              </dl>
            </div>
          ))}
        </>
      )}
      {verifiedCountries.length > 0 && (
        <>
          <p class="fact-section-label">Countries served</p>
          <ul>
            {verifiedCountries.map((c) => (
              <li><strong>{c.label}</strong> — {c.detail}</li>
            ))}
          </ul>
        </>
      )}
      {verifiedSources.length > 0 && (
        <>
          <p class="fact-section-label">Sources</p>
          <ul class="sourced">
            {verifiedSources.map((s) => (
              <li>{s.url ? <a href={s.url}>{s.label}</a> : s.label}</li>
            ))}
          </ul>
        </>
      )}
      {verifiedPartners.length + verifiedCountries.length + verifiedSources.length === 0 && (
        <p class="sourced">Nothing on this profile has been independently verified yet.</p>
      )}
    </div>

    {hasDisclosed && (
      <div class="record disclosed-block">
        <h3>📋 Company disclosures</h3>
        <p class="sourced">Reported by the company itself and not independently verified — treat as
        a claim, not a confirmed fact.</p>

        {disclosedPartners.length > 0 && (
          <>
            <p class="fact-section-label">Who actually holds and executes customer assets</p>
            {disclosedPartners.map((partner) => (
              <div class="provider-card">
                <dl>
                  <dt>Partner</dt>
                  <dd>{partner.ex ? <a href={`/exchange/${partner.ex.id}/`}>{partner.name}</a> : partner.name}</dd>
                  <dt>Role</dt><dd>{partner.role}</dd>
                  <dt>Licence</dt><dd class="datum">{partner.licence}</dd>
                </dl>
              </div>
            ))}
          </>
        )}
        {disclosedCountries.length > 0 && (
          <>
            <p class="fact-section-label">Countries served</p>
            <ul>
              {disclosedCountries.map((c) => (
                <li><strong>{c.label}</strong> — {c.detail}</li>
              ))}
            </ul>
          </>
        )}
        {disclosedSources.length > 0 && (
          <>
            <p class="fact-section-label">Sources</p>
            <ul class="sourced">
              {disclosedSources.map((s) => (
                <li>{s.url ? <a href={s.url} rel="nofollow noopener">{s.label}</a> : s.label}</li>
              ))}
            </ul>
          </>
        )}
      </div>
    )}

    <p class="sourced">Last verified {p.last_verified}. Something out of date, or are you {p.name}
    and want to correct or add detail? <a href="/contact/">Get in touch</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/providers/">Providers</a> · <a href="https://x.com/whichcex">X</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script src="/search.js" defer></script>
</body>
</html>
