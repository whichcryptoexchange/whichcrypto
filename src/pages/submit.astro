---
import { loadExchanges, footerStats } from '../lib/data.js';
import '../styles/global.css';
// Turnstile site keys are public by design (embedded in client HTML), so hardcoding
// this as a fallback is safe. The env var still wins if the build environment sets it.
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const stats = footerStats(loadExchanges());

// Only jurisdictions we actually track -- if a real regulator isn't on
// this list, we cannot verify or list a claim against it, so submitters
// are pointed to Contact instead (see the note under the form).
const JURISDICTIONS = [
  { code: 'MICA', label: 'EU/EEA (MiCA)' },
  { code: 'GB', label: 'UK (FCA)' },
  { code: 'CA', label: 'Canada (FINTRAC)' },
  { code: 'AE', label: 'Dubai (VARA)' },
  { code: 'SG', label: 'Singapore (MAS)' },
  { code: 'US', label: 'US (FinCEN)' },
  { code: 'HK', label: 'Hong Kong (SFC)' },
  { code: 'GI', label: 'Gibraltar (GFSC) -- manually verified, expect a slower turnaround' },
  { code: 'JP', label: 'Japan (FSA)' },
  { code: 'MY', label: 'Malaysia (SC)' },
  { code: 'KR', label: 'South Korea (FIU)' },
];
const PAGE_TITLE = 'Submit Your Exchange | whichcryptoexchange.com';
const PAGE_DESC = 'Officially regulated and not on our register yet? Submit your details for independent verification -- this is a tip queue, not an automatic listing.';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <!-- TrustBox script -->
  <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
  <!-- End TrustBox script -->
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
    </div></nav>
  </header>

  <main class="wrap">
    <h1>Submit your exchange</h1>
    <p class="lede">If you hold a genuine licence or registration in one of the jurisdictions we
    track and aren't on our register yet, tell us here. This is <strong>not</strong> an automatic
    listing: every submission is independently verified against the primary regulator record
    before anything is added, the same way every other entry on this site is sourced.</p>
    <p class="sourced">The most useful thing you can give us is your specific licence or
    registration reference number — that's what lets us confirm your status directly against the
    official register in minutes rather than researching from scratch. Jurisdiction not listed
    below? <a href="/contact/">Get in touch</a> instead — we can't verify a claim against a
    register we don't track.</p>

    {SITEKEY ? (
      <form id="submit-form" class="report-form">
        <label>Brand name
          <input type="text" name="brand_name" required maxlength="200" />
        </label>
        <label>Website
          <input type="url" name="website" required maxlength="300" placeholder="https://" />
        </label>
        <label>Jurisdiction
          <select name="country" required>
            <option value="">Select…</option>
            {JURISDICTIONS.map((j) => <option value={j.code}>{j.label}</option>)}
          </select>
        </label>
        <label>Legal entity holding the licence (if different from the brand name)
          <input type="text" name="legal_entity" maxlength="300" />
        </label>
        <label>Licence / registration reference number
          <input type="text" name="licence_reference" maxlength="200" />
        </label>
        <label>Your contact email
          <input type="email" name="contact_email" required maxlength="200" />
        </label>
        <label>Anything else we should know? (optional)
          <textarea name="notes" maxlength="1000" rows="3"></textarea>
        </label>
        <label class="consent-label">
          <input type="checkbox" name="consent" required />
          I confirm the details above are accurate to the best of my knowledge, and understand
          this is a verification queue, not a guarantee of listing.
        </label>
        <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
        <button type="submit">Submit for verification</button>
        <p class="form-msg sourced" role="status"></p>
      </form>
    ) : (
      <p class="sourced">The submission form is opening soon — in the meantime, email
      contact@whichcryptoexchange.com directly.</p>
    )}
  </main>

  <footer class="site"><div class="wrap">
    <div class="footer-top">
      <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/reviews/">Reviews</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
      <!-- TrustBox widget - Review Collector -->
      <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="6a79a88069053747f3a86e5d" data-style-height="52px" data-style-width="100%" data-token="4446dd34-abb7-486d-9d18-4cb40eab0921">
        <a href="https://www.trustpilot.com/review/whichcryptoexchange.com" target="_blank" rel="noopener">Trustpilot</a>
      </div>
      <!-- End TrustBox widget -->
    </div>
    <p class="footer-meta">{stats.brandCount} brands tracked across {stats.jurisdictionCount} jurisdictions · Data last synced {stats.lastSynced} · <a href="/changelog.xml">RSS</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    const form = document.getElementById('submit-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('.form-msg');
      const fd = new FormData(form);
      const token = form.querySelector('[name="cf-turnstile-response"]')?.value;
      msg.textContent = 'Submitting…';
      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            brand_name: fd.get('brand_name'), website: fd.get('website'),
            country: fd.get('country'), legal_entity: fd.get('legal_entity'),
            licence_reference: fd.get('licence_reference'), contact_email: fd.get('contact_email'),
            notes: fd.get('notes'), consent: fd.get('consent') === 'on', turnstile_token: token,
          }),
        });
        const data = await res.json();
        msg.textContent = data.message ?? data.error ?? 'Something went wrong.';
        if (res.ok) form.reset();
      } catch { msg.textContent = 'Network error — please try again.'; }
    });
  </script>

  <script src="/search.js" defer></script>
</body>
</html>
