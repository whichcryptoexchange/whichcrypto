---
import { loadExchanges, footerStats, countriesInData, COUNTRY_NAMES } from '../lib/data.js';
import '../styles/global.css';

const exchanges = loadExchanges();
const stats = footerStats(exchanges);
const countries = countriesInData(exchanges);
const jurisdictionCount = (ex) => Object.keys(ex.countries ?? {}).length;

const hasGenuineLicence = (ex) => {
  if (ex.eu_status === 'authorised') return true;
  return Object.values(ex.countries ?? {}).some((entry) =>
    (Array.isArray(entry) ? entry : [entry]).some((e) => e.status === 'licensed'));
};

const hasAmlOnlyRegistration = (ex) => Object.values(ex.countries ?? {}).some((entry) =>
  (Array.isArray(entry) ? entry : [entry]).some((e) => e.status === 'registered' || e.status === 'authorised'));

// "Verification depth" -- an opt-in sort, not a default order or a
// displayed score. Deliberately additive, never subtractive: a brand we
// simply haven't researched for audits yet (most of them -- this data is
// hand-curated, not comprehensively synced like licensing) scores the
// same 0 on that half as a brand we researched and found nothing strong.
// We're never claiming "verified absence", only counting verified
// presence, so an unresearched brand is never penalised relative to a
// checked-and-clean one -- the two are indistinguishable here on purpose.
// Licensing is the one dimension synced comprehensively across all
// tracked brands, so it's fair to grade 0/1/2 either way.
const hasCurrentAudit = (ex) => (ex.audits ?? []).some((a) =>
  a.tier === 'full_audit' || (a.tier === 'proof_of_reserves' && a.status === 'active'));
const hasWeakerAuditOnFile = (ex) => (ex.audits ?? []).length > 0 && !hasCurrentAudit(ex);
const verificationDepth = (ex) => {
  const licenceScore = hasGenuineLicence(ex) ? 2 : hasAmlOnlyRegistration(ex) ? 1 : 0;
  const auditScore = hasCurrentAudit(ex) ? 2 : hasWeakerAuditOnFile(ex) ? 1 : 0;
  return licenceScore + auditScore;
};

// A single overall status across EVERY jurisdiction we track, not just the
// EU -- a brand licensed only in Hong Kong or Gibraltar previously showed
// as "No EU entity" here, which read as if it had no verified status at
// all anywhere, even though it genuinely does elsewhere.
const overallStatus = (ex) => {
  if (hasGenuineLicence(ex)) return { label: 'Licensed', cls: 'licensed' };
  if (hasAmlOnlyRegistration(ex)) return { label: 'Registered', cls: 'gb-registered' };
  if (ex.eu_status === 'withdrawn') return { label: 'Withdrawn', cls: 'withdrawn' };
  return { label: 'Not verified', cls: 'neutral' };
};

const earliestSince = (ex) => {
  const dates = [];
  for (const ent of ex.entities ?? []) {
    for (const rec of ent.records ?? []) {
      if (rec.authorised) dates.push(rec.authorised);
    }
  }
  for (const entry of Object.values(ex.countries ?? {})) {
    for (const e of Array.isArray(entry) ? entry : [entry]) {
      if (e.since) dates.push(e.since);
    }
  }
  return dates.sort()[0] ?? '';
};

const auditLabel = (ex) => {
  if (hasCurrentAudit(ex)) return { label: 'Audited', cls: 'licensed' };
  if (hasWeakerAuditOnFile(ex)) return { label: 'On file', cls: 'gb-registered' };
  return { label: '—', cls: 'neutral' };
};

// Status/audit filter values are separate from their display labels
// (kebab-case, no spaces) so they work cleanly as data-attribute values
// and <option> values without any escaping.
const STATUS_FILTER_VALUE = { Licensed: 'licensed', Registered: 'registered', Withdrawn: 'withdrawn', 'Not verified': 'not-verified' };
const AUDIT_FILTER_VALUE = { Audited: 'audited', 'On file': 'on-file', '—': 'none' };

// Regulator is a finer axis than country: a country entry's `via` field
// names the specific regime, since a few countries host more than one
// independent regulator under the same country code (AE: VARA vs ADGM;
// US: FinCEN vs NY DFS) -- same taxonomy as /regulators/'s NON_EEA_SOURCES
// table, kept in sync with it by hand since that page's list is itself
// hand-maintained, not derived from this one.
const VIA_REGULATOR = {
  uk_register: 'FCA',
  dubai_vara: 'VARA',
  adgm_manual: 'ADGM',
  mas_register: 'MAS',
  sfc_register: 'SFC',
  gfsc_manual: 'GFSC',
  jp_fsa_register: 'FSA',
  my_sc_register: 'SC',
  kr_fiu_register: 'FIU',
  nz_manual: 'DIA',
  bvi_manual: 'BVIFSC',
  ny_dfs_register: 'NYDFS',
};
const REGULATOR_LABELS = {
  ADGM: 'Abu Dhabi ADGM', BVIFSC: 'BVI FSC', FINTRAC: 'Canada FINTRAC', VARA: 'Dubai VARA',
  MICA: 'EU/EEA (MiCA, any national regulator)', GFSC: 'Gibraltar GFSC', SFC: 'Hong Kong SFC',
  FSA: 'Japan FSA', FIU: 'Korea FIU', SC: 'Malaysia SC', DIA: 'New Zealand DIA',
  MAS: 'Singapore MAS', FCA: 'UK FCA', FINCEN: 'US FinCEN', NYDFS: 'US NY DFS',
};
// msb_register is the shared "MSB registration" via value for BOTH US
// FinCEN and Canada FINTRAC -- the country code, not the via string,
// disambiguates which regulator actually granted it.
const regulatorCodesForExchange = (ex) => {
  const codes = new Set();
  if (ex.eu_status === 'authorised') codes.add('MICA');
  for (const [cc, entry] of Object.entries(ex.countries ?? {})) {
    for (const e of Array.isArray(entry) ? entry : [entry]) {
      if (e.via === 'msb_register') codes.add(cc === 'CA' ? 'FINTRAC' : 'FINCEN');
      else if (VIA_REGULATOR[e.via]) codes.add(VIA_REGULATOR[e.via]);
    }
  }
  return codes;
};

const rows = exchanges.map((ex) => ({
  ex,
  jurisdictions: jurisdictionCount(ex),
  status: overallStatus(ex),
  since: earliestSince(ex),
  verification: verificationDepth(ex),
  audit: auditLabel(ex),
  countryCodes: Object.keys(ex.countries ?? {}),
  regulatorCodes: [...regulatorCodesForExchange(ex)],
}));
const regulatorsInData = [...new Set(rows.flatMap((r) => r.regulatorCodes))]
  .sort((a, b) => REGULATOR_LABELS[a].localeCompare(REGULATOR_LABELS[b]));
const SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAD84t4OWkoouLP3Y';
const PAGE_TITLE = `Crypto Exchange List: ${exchanges.length} Tracked | whichcryptoexchange.com`;
const PAGE_DESC = `A list of every crypto exchange and related firm we track (${exchanges.length} total), sortable by jurisdiction count or authorisation date. Every entry links to its full regulatory record.`;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:site_name" content="whichcryptoexchange.com" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={PAGE_TITLE} />
  <meta name="twitter:description" content={PAGE_DESC} />
  <meta name="twitter:image" content="https://whichcryptoexchange.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="QTM3lN9yt0oU0rxrj5zadA" async></script>
  <!-- TrustBox script -->
  <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
  <!-- End TrustBox script -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: exchanges.length,
    itemListElement: exchanges.map((ex, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: ex.brand,
      url: `https://whichcryptoexchange.com/exchange/${ex.id}/`,
    })),
  })} />
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">which<em>crypto</em>exchange</a>
      <div class="header-right">
        <div class="site-search">
          <input type="search" id="site-search" placeholder="Search exchanges or countries…" autocomplete="off" aria-label="Search exchanges" />
          <div class="site-search-results" id="site-search-results" hidden></div>
        </div>
        <span class="sourced">source: official regulator registers</span>
      </div>
    </div>
    <nav class="site-nav"><div class="wrap">
      <a href="/exchanges/">Exchanges</a>
      <a href="/regulators/">Regulators</a>
      <a href="/providers/">Providers</a>
      <a href="/faq/">FAQ</a>
      <a href="/stats/">Stats</a>
      <a href="/reviews/">Reviews</a>
      <a href="/news/">News</a>
    </div></nav>
  </header>

  <main class="wrap">
    <div class="page-header">
      <div class="page-header-main">
        <h1>Crypto exchange list: all tracked exchanges</h1>
        <p class="lede">A list of every exchange and related firm in our register, {exchanges.length} total.
        Click through to any brand for its full regulatory record across every jurisdiction we track —
        checked against the regulator directly, not the exchange's own claims.</p>
      </div>
      <div class="submit-cta">
        <h3>Officially regulated?</h3>
        <p>Add your brand to the register. Not automatic — we independently verify every claim
        before publishing anything.</p>
        <a class="button-link" href="/submit/">Submit your details</a>
      </div>
    </div>
    <p class="sourced">Status is the best evidence found <em>anywhere</em> we track, not just the
    EU: <strong>Licensed</strong> means a genuine crypto-specific licence in at least one
    jurisdiction (a brand can still hold AML-only registrations elsewhere too);
    <strong> Registered</strong> means AML-only registration with no genuine licence found;
    <strong> Withdrawn</strong> means a former EU authorisation has lapsed. See each brand's own page
    for the full per-jurisdiction breakdown.</p>

    {SITEKEY && (
      <div class="digest-cta">
        <h3>Get the weekly regulatory roundup</h3>
        <p>Every status change across every tracked exchange, once a week, straight to your inbox.
        Free, no spam — one email a week, unsubscribe any time.</p>
        <form id="digest-form">
          <div class="digest-cta-row">
            <input type="email" name="email" placeholder="you@example.com" required maxlength="200" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </div>
          <label class="consent-label">
            <input type="checkbox" name="consent" required />
            I want the weekly regulatory roundup email. See <a href="/about/">how this works</a> —
            unsubscribe any time, no login needed.
          </label>
          <div class="cf-turnstile" data-sitekey={SITEKEY}></div>
          <p class="form-msg sourced" role="status"></p>
        </form>
      </div>
    )}

    <div class="table-controls">
      <label>Sort by
        <select id="sort-select">
          <option value="brand">Brand (A–Z)</option>
          <option value="jurisdictions-desc">Most jurisdictions first</option>
          <option value="since-desc">Newest first</option>
          <option value="since-asc">Oldest first</option>
          <option value="verification-desc">Verification depth (most first)</option>
        </select>
      </label>
      <label>Country
        <select id="filter-country">
          <option value="">All countries</option>
          {countries.map((c) => <option value={c}>{COUNTRY_NAMES[c] ?? c}</option>)}
        </select>
      </label>
      <a id="country-page-link" class="country-page-link" href="#" hidden></a>
      <label>Regulator
        <select id="filter-regulator">
          <option value="">All regulators</option>
          {regulatorsInData.map((r) => <option value={r}>{REGULATOR_LABELS[r]}</option>)}
        </select>
      </label>
      <label>Status
        <select id="filter-status">
          <option value="">All statuses</option>
          <option value="licensed">Licensed only</option>
          <option value="registered">Registered (AML-only) only</option>
          <option value="withdrawn">Withdrawn</option>
          <option value="not-verified">Not verified anywhere</option>
        </select>
      </label>
      <label>Audit &amp; reserves
        <select id="filter-audit">
          <option value="">All</option>
          <option value="audited">Audited (current) only</option>
          <option value="on-file">Any audit info on file</option>
        </select>
      </label>
      <button type="button" id="filter-reset" class="filter-reset" hidden>Reset filters</button>
    </div>
    <p class="sourced" id="filter-count"></p>
    <p class="sourced">"Verification depth" is not a rating -- it's a plain count: 2 points for a
    genuine licence (1 for AML-only registration, 0 for neither), plus 2 for a currently
    independently-audited proof-of-reserves or full audit (1 for a weaker or lapsed one on file, 0
    if we haven't researched that brand's audit history yet -- most haven't been, since that's
    hand-curated, not synced). A brand with 0 there was very likely just never checked, not found
    lacking -- see <a href="/exchange/binance/">an exchange page</a> for how these facts actually
    read in full.</p>

    <div class="table-scroll">
    <table class="registry">
      <thead><tr>
        <th>Exchange</th><th>Status</th><th>Audit</th><th>Jurisdictions</th><th>Since</th>
      </tr></thead>
      <tbody>
        {rows.map(({ ex, jurisdictions, status, since, verification, audit, countryCodes, regulatorCodes }) => (
          <tr data-since={since} data-jurisdictions={jurisdictions} data-verification={verification}
              data-countries={countryCodes.join(' ')} data-status={STATUS_FILTER_VALUE[status.label]}
              data-audit={AUDIT_FILTER_VALUE[audit.label]} data-regulators={regulatorCodes.join(' ')}>
            <td class="brand"><a href={`/exchange/${ex.id}/`}>{ex.brand}</a></td>
            <td><span class={`stamp ${status.cls}`}>{status.label}</span></td>
            <td><span class={`stamp ${audit.cls}`}>{audit.label}</span></td>
            <td class="datum">{jurisdictions}</td>
            <td class="datum">{since || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <p class="sourced">Want the full dataset? <a href="/api/exchanges.json">JSON</a> ·
    <a href="/api/register-snapshot.csv">CSV snapshot</a>.</p>
  </main>

  <footer class="site"><div class="wrap">
    <div class="footer-top">
      <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/changelog/">Changelog</a> · <a href="/exchanges/">Exchanges</a> · <a href="/regulators/">Regulators</a> · <a href="/stats/">Stats</a> · <a href="/reviews/">Reviews</a> · <a href="/news/">News</a> · <a href="/providers/">Providers</a> · <a href="/faq/">FAQ</a> · <a href="https://x.com/whichcex">X</a></p>
      <!-- TrustBox widget - Review Collector -->
      <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="6a79a88069053747f3a86e5d" data-style-height="52px" data-style-width="100%" data-token="4446dd34-abb7-486d-9d18-4cb40eab0921">
        <a href="https://www.trustpilot.com/review/whichcryptoexchange.com" target="_blank" rel="noopener">Trustpilot</a>
      </div>
      <!-- End TrustBox widget -->
    </div>
    <p class="footer-meta">{stats.brandCount} brands tracked across {stats.jurisdictionCount} jurisdictions · Data last synced {stats.lastSynced} · <a href="/changelog.xml">RSS</a></p>
    <p>Independent register. Not affiliated with any regulator. Not financial advice.</p>
  </div></footer>

  <script>
    const tbody = document.querySelector('.registry tbody');
    const sortSelect = document.getElementById('sort-select');
    const countryFilter = document.getElementById('filter-country');
    const countryPageLink = document.getElementById('country-page-link');
    const regulatorFilter = document.getElementById('filter-regulator');
    const statusFilter = document.getElementById('filter-status');
    const auditFilter = document.getElementById('filter-audit');
    const resetBtn = document.getElementById('filter-reset');
    const countEl = document.getElementById('filter-count');
    if (tbody && sortSelect) {
      const originalRows = [...tbody.querySelectorAll('tr')];
      const total = originalRows.length;

      // Filters narrow which rows are visible; sort only ever reorders --
      // the two are independent and every apply() re-derives both from
      // scratch off originalRows, so they never fight over row order or
      // display state no matter what order the controls are touched in.
      const apply = () => {
        let rows = [...originalRows];
        switch (sortSelect.value) {
          case 'since-desc':
            rows.sort((a, b) => (b.dataset.since || '').localeCompare(a.dataset.since || ''));
            break;
          case 'since-asc':
            rows.sort((a, b) => {
              const av = a.dataset.since, bv = b.dataset.since;
              if (!av) return 1;
              if (!bv) return -1;
              return av.localeCompare(bv);
            });
            break;
          case 'jurisdictions-desc':
            rows.sort((a, b) => Number(b.dataset.jurisdictions || 0) - Number(a.dataset.jurisdictions || 0));
            break;
          case 'verification-desc':
            rows.sort((a, b) => Number(b.dataset.verification || 0) - Number(a.dataset.verification || 0));
            break;
          default:
            break; // 'brand': original server-rendered A–Z order
        }
        rows.forEach((r) => tbody.appendChild(r));

        const cc = countryFilter?.value, rg = regulatorFilter?.value, st = statusFilter?.value, au = auditFilter?.value;
        // Filtering to a single country is exactly the moment someone wants
        // that country's own page too -- its regulator detail, its "which/
        // best crypto exchange" guidance section, none of which belongs
        // cluttering this cross-country table. Pull the display name straight
        // off the selected <option> rather than duplicating COUNTRY_NAMES
        // into this script.
        if (countryPageLink) {
          if (cc) {
            const label = countryFilter.options[countryFilter.selectedIndex]?.textContent ?? cc;
            countryPageLink.href = `/${cc.toLowerCase()}/`;
            countryPageLink.textContent = `See the full ${label} page →`;
            countryPageLink.hidden = false;
          } else {
            countryPageLink.hidden = true;
          }
        }
        let shown = 0;
        for (const r of rows) {
          const matchesCountry = !cc || (r.dataset.countries || '').split(' ').includes(cc);
          const matchesRegulator = !rg || (r.dataset.regulators || '').split(' ').includes(rg);
          const matchesStatus = !st || r.dataset.status === st;
          // 'on-file' is the broad option -- audited counts as "info on
          // file" too, only 'none' is excluded. 'audited' is the strict
          // option -- only the strong tier matches.
          const matchesAudit = !au || (au === 'on-file' ? r.dataset.audit !== 'none' : r.dataset.audit === au);
          const visible = matchesCountry && matchesRegulator && matchesStatus && matchesAudit;
          r.hidden = !visible;
          if (visible) shown++;
        }
        const filtered = Boolean(cc || rg || st || au);
        if (resetBtn) resetBtn.hidden = !filtered;
        if (countEl) countEl.textContent = filtered ? `Showing ${shown} of ${total} exchanges.` : '';
      };
      sortSelect.addEventListener('change', apply);
      countryFilter?.addEventListener('change', apply);
      regulatorFilter?.addEventListener('change', apply);
      statusFilter?.addEventListener('change', apply);
      auditFilter?.addEventListener('change', apply);
      resetBtn?.addEventListener('click', () => {
        if (countryFilter) countryFilter.value = '';
        if (regulatorFilter) regulatorFilter.value = '';
        if (statusFilter) statusFilter.value = '';
        if (auditFilter) auditFilter.value = '';
        apply();
      });
    }
  </script>

  {SITEKEY && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="/search.js" defer></script>
</body>
</html>
